 static int fp6_gmu_clocks_prepare(struct fp6_smmu_clocks *);
 
+
+/*
+ * This GPU SMMU reports IDR0.ATOSNS (bit 26): no address translation
+ * operations, so ATS1PR/PAR never change (PAR reads 0). Linux arm-smmu
+ * likewise only uses ATOS without ATOSNS. Verify mappings by walking our
+ * own tables on the CPU with the context's format: 4 KiB granule, T0SZ=32
+ * (start at level 1), table/page descriptors with AF on the page.
+ */
+#define FP6_SMMU_ID0_ATOSNS     (1u << 26)
+typedef volatile uint64_t *(*fp6_table_map_t)(void *ctx, uint64_t pa, uint32_t iova, unsigned level);
+
+static uint64_t
+fp6_smmu_soft_walk(fp6_table_map_t map, void *ctx, uint64_t root_pa, uint32_t iova)
+{
+	uint64_t table = root_pa;
+	for (unsigned level = 1; level <= 3; level++) {
+		volatile uint64_t *t = map(ctx, table, iova, level);
+		if (!t) return ~0ULL;
+		unsigned shift = 39u - 9u * level;              /* 30, 21, 12 */
+		uint64_t desc = t[(iova >> shift) & 511u];
+		if ((desc & 3u) != 3u) return ~0ULL;            /* invalid (no blocks used) */
+		uint64_t next = desc & 0x0000fffffffff000ULL;
+		if (level == 3) {
+			if (!(desc & (1ULL << 10))) return ~0ULL;       /* AF */
+			return next | (iova & 0xfffu);
+		}
+		table = next;
+	}
+	return ~0ULL;
+}
+
+struct fp6_flat_tables { vm_offset_t va; uint64_t pa; uint32_t size; };
+
+static volatile uint64_t *
+fp6_flat_table_map(void *ctx, uint64_t pa, uint32_t iova, unsigned level)
+{
+	(void)iova; (void)level;
+	struct fp6_flat_tables *f = ctx;
+	if (pa < f->pa || pa - f->pa >= f->size || (pa & 0xfffu)) return NULL;
+	return (volatile uint64_t *)(uintptr_t)(f->va + (pa - f->pa));
+}
+
+static volatile uint64_t *
+fp6_domain_table_map(void *ctx, uint64_t pa, uint32_t iova, unsigned level)
+{
+	struct fp6_gmu_domain *d = ctx;
+	if (level == 1)
+		return d->root.va && d->root.pa == pa ? (volatile uint64_t *)(void *)d->root.va : NULL;
+	unsigned i = (iova >> 30) & 3u;
+	if (level == 2)
+		return d->l2[i].va && d->l2[i].pa == pa ? (volatile uint64_t *)(void *)d->l2[i].va : NULL;
+	if (level == 3) {
+		unsigned j = (iova >> 21) & 511u;
+		return d->l3[i][j].va && d->l3[i][j].pa == pa ? (volatile uint64_t *)(void *)d->l3[i][j].va : NULL;
+	}
+	return NULL;
+}
