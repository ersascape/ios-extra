+/* Replay of Mesa captures at their original IOVAs through a TTBR0 address space.
+ * CB0 keeps the TTBR1 global window; TTBR0 gets a fresh 4-level table per capture
+ * mapping every captured page (read/write, unprivileged, execute-never) at the
+ * address Mesa used, so the stream runs unchanged via one CP_INDIRECT_BUFFER.
+ * Backing and tables are permanent: the GPU may keep translations. */
+#define FP6_AS_MAX_TABLES 24u
+#define FP6_AS_MAX_PAGES  140u
+#define FP6_AS_PTE_PAGE (3ull | (1ull << 10) | (2ull << 8) | (1ull << 11) | (1ull << 6) | (3ull << 53))
+#define FP6_AS_TCR_TTBR0 0xa0102010u /* 0xa0100080: T0SZ=16, SH0=outer, TG0=4K, EPD0=0 */
+static struct fp6_gpu_global_page fp6_as_tables[FP6_AS_MAX_TABLES];
+static struct fp6_gpu_global_page fp6_as_pages[FP6_AS_MAX_PAGES];
+static unsigned fp6_as_table_count, fp6_as_page_count;
+static int fp6_replay_done[FP6_REPLAY_COUNT];
+
+static struct fp6_gpu_global_page *
+fp6_as_new_table(void)
+{
+	if (fp6_as_table_count == FP6_AS_MAX_TABLES ||
+	    fp6_gpu_kernel_alloc(NULL, 4096u, &fp6_as_tables[fp6_as_table_count])) return NULL;
+	return &fp6_as_tables[fp6_as_table_count++];
+}
+
+static struct fp6_gpu_global_page *
+fp6_as_table_by_pa(uint64_t pa)
+{
+	for (unsigned i = 0; i < fp6_as_table_count; i++)
+		if (fp6_as_tables[i].pa == pa) return &fp6_as_tables[i];
+	return NULL;
+}
+
+static int
+fp6_as_map(struct fp6_gpu_global_page *l0, uint64_t va, uint64_t pa)
+{
+	struct fp6_gpu_global_page *t = l0;
+	for (unsigned level = 0; level < 3u; level++) {
+		unsigned idx = (unsigned)((va >> (39u - 9u * level)) & 511u);
+		volatile uint64_t *e = (volatile uint64_t *)(void *)t->va + idx;
+		if (!*e) {
+			struct fp6_gpu_global_page *n = fp6_as_new_table();
+			if (!n) return 0;
+			*e = n->pa | 3ull;
+		}
+		t = fp6_as_table_by_pa(*e & 0x0000fffffffff000ull);
+		if (!t) return 0;
+	}
+	volatile uint64_t *leaf = (volatile uint64_t *)(void *)t->va + ((va >> 12) & 511u);
+	if (*leaf) return 0;
+	*leaf = pa | FP6_AS_PTE_PAGE;
+	return 1;
+}
+
+static struct fp6_gpu_global_page *
+fp6_as_find_page(const struct fp6_replay *r, unsigned first_page, uint64_t va)
+{
+	for (unsigned i = 0; i < r->npages; i++)
+		if (r->pages[i].va == (va & ~0xfffull)) return &fp6_as_pages[first_page + i];
+	return NULL;
+}
+
+static int
+fp6_replay_build(const struct fp6_replay *r, unsigned first_page, uint64_t *l0_pa)
+{
+	struct fp6_gpu_global_page *l0 = fp6_as_new_table();
+	if (!l0 || fp6_as_page_count + r->npages > FP6_AS_MAX_PAGES) return 0;
+	for (unsigned i = 0; i < r->npages; i++) {
+		struct fp6_gpu_global_page *page = &fp6_as_pages[first_page + i];
+		if (fp6_gpu_kernel_alloc(NULL, 4096u, page)) return 0;
+		fp6_as_page_count++;
+		uint32_t *words = (uint32_t *)(void *)page->va;
+		for (unsigned k = 0; k < r->pages[i].npairs; k++)
+			words[r->pages[i].pairs[2 * k]] = r->pages[i].pairs[2 * k + 1];
+		(void)fp6_gpu_kernel_publish(NULL, page->va, 4096u);
+		if (!fp6_as_map(l0, r->pages[i].va, page->pa)) return 0;
+	}
+	for (unsigned i = 0; i < fp6_as_table_count; i++)
+		(void)fp6_gpu_kernel_publish(NULL, fp6_as_tables[i].va, 4096u);
+	*l0_pa = l0->pa;
+	return 1;
+}
+
+static int
+fp6_replay_activate(uint64_t l0_pa)
+{
+	vm_offset_t smmu = fp6_gpu_smmu_base;
+	uint32_t cb = fp6_gpu_cb_off;
+	fp6_smmu_write64(smmu, cb + FP6_SMMU_CB_TTBR0, l0_pa);
+	fp6_smmu_write32(smmu, cb + FP6_SMMU_CB_TCR, FP6_AS_TCR_TTBR0);
+	fp6_smmu_write32(smmu, cb + FP6_SMMU_CB_TLBIALL, FP6_SMMU_DUMMY_VAL);
+	fp6_smmu_write32(smmu, cb + FP6_SMMU_CB_TLBSYNC, FP6_SMMU_DUMMY_VAL);
+	for (unsigned i = 0; i < 1000u; i++) {
+		if (!(fp6_smmu_read32(smmu, cb + FP6_SMMU_CB_TLBSTATUS) & 1u)) {
+			__asm__ volatile("dsb sy" ::: "memory");
+			return fp6_smmu_read64(smmu, cb + FP6_SMMU_CB_TTBR0) == l0_pa &&
+			    fp6_smmu_read32(smmu, cb + FP6_SMMU_CB_TCR) == FP6_AS_TCR_TTBR0;
+		}
+		delay(10);
+	}
+	return 0;
+}
+
+#define FP6_REPLAY_FENCE_OFFSET 0x100u /* dword index in the result page */
+#define FP6_REPLAY_FENCE_VALUE 0x600dcafeu
+
+static int
+fp6_replay_run(vm_offset_t g, vm_offset_t gpu, unsigned index)
+{
+	const struct fp6_replay *r = &fp6_replays[index];
+	unsigned first_page = fp6_as_page_count;
+	uint64_t l0_pa = 0;
+	if (!fp6_replay_build(r, first_page, &l0_pa)) {
+		printf("QCOM GPU REPLAY: %s address-space build failed (tables=%u pages=%u)\n", r->name,
+		    fp6_as_table_count, fp6_as_page_count);
+		return 0;
+	}
+	printf("QCOM GPU REPLAY: %s mapped %u pages, root=0x%llx tables=%u\n", r->name, r->npages,
+	    (unsigned long long)l0_pa, fp6_as_table_count);
+	if (!fp6_replay_activate(l0_pa)) {
+		printf("QCOM GPU REPLAY: %s TTBR0/TCR activation failed\n", r->name);
+		return 0;
+	}
+	uint64_t base = ((uint64_t)fp6_smmu_read32(gpu, FP6_GPU_CP_RB_BASE_HI) << 32) |
+	    fp6_smmu_read32(gpu, FP6_GPU_CP_RB_BASE_LO);
+	uint32_t cntl = fp6_smmu_read32(gpu, FP6_GPU_CP_RB_CNTL);
+	uint32_t rptr = fp6_smmu_read32(gpu, FP6_GPU_CP_RB_RPTR_BR);
+	uint32_t wptr = fp6_smmu_read32(gpu, FP6_GPU_CP_RB_WPTR_GC);
+	struct fp6_hfi_mem_alloc *ring = NULL;
+	for (unsigned i = 0; i < fp6_hfi_mem_alloc_count; i++) {
+		if (fp6_hfi_mem_allocs[i].mem_kind == 1u && base &&
+		    fp6_hfi_mem_allocs[i].gpu_address == base) {
+			ring = &fp6_hfi_mem_allocs[i];
+			break;
+		}
+	}
+	uint64_t size = (uint64_t)2 << (cntl & 0xffu);
+	uint32_t cmd[16];
+	unsigned n = 0;
+	cmd[n++] = fp6_cp_type7_packet(0x17u, 1u); /* CP_THREAD_CONTROL: BR, sync */
+	cmd[n++] = 1u | (1u << 31);
+	cmd[n++] = fp6_cp_type7_packet(0x26u, 0u); /* CP_WAIT_FOR_IDLE */
+	cmd[n++] = fp6_cp_type7_packet(0x3fu, 3u); /* CP_INDIRECT_BUFFER */
+	cmd[n++] = (uint32_t)r->ib_va;
+	cmd[n++] = (uint32_t)(r->ib_va >> 32);
+	cmd[n++] = r->ib_dwords;
+	cmd[n++] = fp6_cp_type7_packet(0x26u, 0u);
+	cmd[n++] = fp6_cp_type7_packet(0x3du, 3u); /* CP_MEM_WRITE fence */
+	cmd[n++] = (uint32_t)(fp6_exec_result_va + 4u * FP6_REPLAY_FENCE_OFFSET);
+	cmd[n++] = (uint32_t)((fp6_exec_result_va + 4u * FP6_REPLAY_FENCE_OFFSET) >> 32);
+	cmd[n++] = FP6_REPLAY_FENCE_VALUE;
+	cmd[n++] = fp6_cp_type7_packet(0x17u, 1u); /* CP_THREAD_CONTROL: both */
+	cmd[n++] = 3u;
+	if (!ring || rptr != wptr || (uint64_t)wptr + n >= size || size * 4u > ring->desc[7]) {
+		printf("QCOM GPU REPLAY: %s ring unavailable (ring=%u size=%llu rptr=%u wptr=%u)\n",
+		    r->name, ring != NULL, (unsigned long long)size, rptr, wptr);
+		return 0;
+	}
+	volatile uint32_t *fence = (volatile uint32_t *)(void *)(fp6_exec_result.va + 4u * FP6_REPLAY_FENCE_OFFSET);
+	*fence = 0xdeadbeefu;
+	(void)fp6_gpu_kernel_publish(NULL, fp6_exec_result.va, 4096u);
+	volatile uint32_t *slot = (volatile uint32_t *)(void *)(ring->backing.va + 4u * wptr);
+	for (unsigned i = 0; i < n; i++) slot[i] = cmd[i];
+	(void)fp6_gpu_kernel_publish(NULL, ring->backing.va + 4u * wptr, 4u * n);
+	__asm__ volatile("dsb sy" ::: "memory");
+	unsigned dropped = 0;
+	for (unsigned attempt = 0; attempt < 2u; attempt++) {
+		fp6_smmu_write32(gpu, FP6_GPU_CP_RB_WPTR_GC, wptr + n);
+		dropped = fp6_smmu_read32(g, FP6_GMU_AHB_FENCE_STATUS) & 1u;
+		if (!dropped) break;
+	}
+	uint32_t seen = 0, now_rptr = 0;
+	for (unsigned i = 0; i < 10000u; i++) {
+		fp6_gpu_invalidate_cpu_cache(fp6_exec_result.va, 4096u);
+		seen = *fence;
+		now_rptr = fp6_smmu_read32(gpu, FP6_GPU_CP_RB_RPTR_BR);
+		if (seen == FP6_REPLAY_FENCE_VALUE && now_rptr == wptr + n) break;
+		delay(100);
+	}
+	unsigned good = 0, total = 0, colored = 0;
+	if (r->check == FP6_REPLAY_CHECK_ADD5) {
+		struct fp6_gpu_global_page *page = fp6_as_find_page(r, first_page, r->check_va);
+		if (page) {
+			fp6_gpu_invalidate_cpu_cache(page->va, 4096u);
+			const volatile uint32_t *d = (const volatile uint32_t *)(const void *)
+			    (page->va + (r->check_va & 0xfffull));
+			total = r->elements;
+			for (unsigned i = 0; i < total; i++) good += d[i] == r->init[i] + 5u;
+			printf("QCOM GPU REPLAY: %s data=%u,%u,%u,%u,%u,%u,%u,%u\n", r->name,
+			    d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]);
+		}
+	} else {
+		for (unsigned i = 0; i < r->npages; i++) {
+			struct fp6_gpu_global_page *page = &fp6_as_pages[first_page + i];
+			if (r->pages[i].npairs) continue; /* only buffers the capture left zero */
+			fp6_gpu_invalidate_cpu_cache(page->va, 4096u);
+			const volatile uint32_t *d = (const volatile uint32_t *)(const void *)page->va;
+			unsigned here = 0;
+			for (unsigned k = 0; k < 1024u; k++) here += d[k] == 0xff4080ffu;
+			if (here) printf("QCOM GPU REPLAY: %s page va=0x%llx has %u pixels of 0xff4080ff\n",
+			    r->name, (unsigned long long)r->pages[i].va, here);
+			colored += here;
+		}
+		total = 1;
+		good = colored >= 300u && colored <= 700u;
+	}
+	printf("QCOM GPU REPLAY: %s dropped=%u fence=0x%08x rptr=%u/%u check=%u/%u colored=%u CB0_FSR=0x%08x\n",
+	    r->name, dropped, seen, now_rptr, wptr + n, good, total, colored,
+	    fp6_smmu_read32(fp6_gpu_smmu_base, fp6_gpu_cb_off + FP6_SMMU_CB_FSR));
+	if (seen != FP6_REPLAY_FENCE_VALUE || good != total) {
+		fp6_gpu_exec_snapshot(g, gpu, "after-replay");
+		return 0;
+	}
+	fp6_replay_done[index] = 1;
+	return 1;
+}
+
+/* fp6gpureplay=1 replays every capture once, in table order, stopping at the
+ * first failure. */
+static int
+fp6_gpu_replay_probe(vm_offset_t g, vm_offset_t gpu)
+{
+	int wanted = 0;
+	if (!PE_parse_boot_argn("fp6gpureplay", &wanted, sizeof(wanted)) || wanted != 1) {
+		printf("QCOM GPU REPLAY: skipped; fp6gpureplay=1 not requested\n");
+		return 1;
+	}
+	if (!fp6_exec_pages_ready) {
+		printf("QCOM GPU REPLAY: refused; execution pages unavailable\n");
+		return 0;
+	}
+	for (unsigned i = 0; i < FP6_REPLAY_COUNT; i++) {
+		if (!fp6_replay_run(g, gpu, i)) {
+			printf("QCOM GPU REPLAY: %s failed; %u of %u captures passed\n", fp6_replays[i].name, i,
+			    (unsigned)FP6_REPLAY_COUNT);
+			return 0;
+		}
+	}
+	printf("QCOM GPU REPLAY: all %u captures passed\n", (unsigned)FP6_REPLAY_COUNT);
+	return 1;
+}
