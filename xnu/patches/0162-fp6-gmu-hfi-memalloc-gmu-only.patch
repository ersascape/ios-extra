+static uint32_t
+fp6_gmu_hfi_find_va(int cached, uint32_t size, uint32_t align)
+{
+	uint64_t first = cached ? 0x00004000ULL : 0x60000000ULL;
+	uint64_t limit = cached ? 0x01000000ULL : 0x80000000ULL;
+	unsigned va_exp = align & 0xffu;
+	unsigned size_exp = (align >> 8) & 0xffu;
+	if (va_exp > 30u || size_exp > 12u) return 0;
+	uint64_t va_align = va_exp > 12u ? (1ULL << va_exp) : 4096ULL;
+	uint64_t map_size = ((uint64_t)size + 4095ULL) & ~4095ULL;
+	uint64_t va = first;
+	if (!map_size || map_size > limit - first) return 0;
+	for (unsigned pass = 0; pass <= fp6_gmu_domain.count; pass++) {
+		va = (va + va_align - 1ULL) & ~(va_align - 1ULL);
+		if (va + map_size > limit) return 0;
+		int collided = 0;
+		for (unsigned i = 0; i < fp6_gmu_domain.count; i++) {
+			struct fp6_gmu_domain_range *r = &fp6_gmu_domain.ranges[i];
+			uint64_t end = (uint64_t)r->address + r->mapped_size;
+			if (va < end && r->address < va + map_size) {
+				va = end;
+				collided = 1;
+				break;
+			}
+		}
+		if (!collided) return (uint32_t)va;
+	}
+	return 0;
+}
