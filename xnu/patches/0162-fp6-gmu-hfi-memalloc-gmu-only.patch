+/* Linux gen8_hwsched_hfi.c supports 32 tracked MEM_ALLOC records. For this
+ * first runtime allocator, only GMU-only kernel blocks are serviced; GPU
+ * global allocations still require the A810 GPU-MMU heap. */
+#define FP6_HFI_MEM_ALLOC_MAX 32u
+#define FP6_HFI_MEMKIND_HW_FENCE 23u
+#define FP6_HFI_MEMKIND_MMIO_IPC_CORE 19u
+#define FP6_HFI_MEMKIND_MAX 26u
+#define FP6_HFI_MEMFLAG_GFX_ACC (1u << 0)
+#define FP6_HFI_MEMFLAG_GMU_CACHEABLE (1u << 7)
+#define FP6_HFI_MEMFLAG_GMU_PRIV (1u << 4)
+#define FP6_HFI_MEMFLAG_GMU_WRITEABLE (1u << 5)
+#define FP6_HFI_MEMFLAG_GFX_SECURE (1u << 12)
+struct fp6_hfi_mem_alloc {
+	uint32_t mem_kind, gmu_handle;
+	uint32_t desc[9]; /* gpu_addr[2], flags, kind, host, gmu_handle, gmu_addr, size, align */
+};
+static struct fp6_hfi_mem_alloc fp6_hfi_mem_allocs[FP6_HFI_MEM_ALLOC_MAX];
+static unsigned fp6_hfi_mem_alloc_count;
