+/* Publish one append-only range into the live GMU domain. Firmware is blocked
+ * on its HFI allocation request while page tables are cleaned and the context
+ * TLB is invalidated. All memory remains permanent if any later step fails. */
+static int
+fp6_gmu_domain_map_live(vm_offset_t smmu, uint32_t cb_off,
+		uint32_t address, uint32_t size, int cached, uint32_t flags)
+{
+	if (!smmu || !fp6_gmu_domain.frozen || fp6_gmu_domain.failed ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_SCTLR) != 0x27u) {
+		printf("QCOM GMU: HFI MEM_ALLOC map refused: domain/context not live\n");
+		return 0;
+	}
+	fp6_gmu_domain.frozen = 0;
+	int mapped = fp6_gmu_domain_reserve_access(&fp6_gmu_domain, address, size,
+	    cached, (flags & FP6_HFI_MEMFLAG_GMU_WRITEABLE) != 0,
+	    (flags & FP6_HFI_MEMFLAG_GMU_PRIV) != 0);
+	if (!mapped) mapped = fp6_gmu_domain_publish(&fp6_gmu_domain);
+	fp6_gmu_domain.frozen = 1;
+	if (mapped) {
+		printf("QCOM GMU: HFI MEM_ALLOC map failed IOVA=0x%x size=%u\n", address, size);
+		return 0;
+	}
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_TLBIALL, FP6_SMMU_DUMMY_VAL);
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_TLBSYNC, FP6_SMMU_DUMMY_VAL);
+	unsigned polls;
+	for (polls = 0; polls < 1000u; polls++) {
+		if (!(fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_TLBSTATUS) & 1u)) break;
+		delay(10);
+	}
+	if (polls == 1000u) {
+		printf("QCOM GMU: HFI MEM_ALLOC TLB sync timeout IOVA=0x%x; CM3 reset required\n", address);
+		return 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 1;
+}
