diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -5032,6 +5032,23 @@
 	}
 	printf("QCOM GPU REPLAY: %s mapped %u pages, root=0x%llx tables=%u\n", r->name, r->npages,
 	    (unsigned long long)l0_pa, fp6_as_table_count);
+	/* Turnip patches CP_THREAD_CONTROL at submit time: plain BR when concurrent binning
+	 * is on. fp6gpureplaycb=1 clears CONCURRENT_BIN_DISABLE in the captured stream to test
+	 * whether that bit alone is what stalls the BR thread. */
+	int clear_cbd = 0;
+	if (r->ncbd && PE_parse_boot_argn("fp6gpureplaycb", &clear_cbd, sizeof(clear_cbd)) && clear_cbd == 1) {
+		unsigned cleared = 0;
+		for (unsigned k = 0; k < r->ncbd; k++) {
+			struct fp6_gpu_global_page *page = fp6_as_find_page(r, first_page, r->cbd[k]);
+			if (!page) continue;
+			volatile uint32_t *word = (volatile uint32_t *)(void *)(page->va + (r->cbd[k] & 0xfffull));
+			*word &= ~(1u << 27);
+			(void)fp6_gpu_kernel_publish(NULL, page->va, 4096u);
+			cleared++;
+		}
+		printf("QCOM GPU REPLAY: %s cleared CONCURRENT_BIN_DISABLE in %u of %u thread-control packets\n",
+		    r->name, cleared, r->ncbd);
+	}
 	if (!fp6_replay_activate(l0_pa)) {
 		printf("QCOM GPU REPLAY: %s TTBR0/TCR activation failed\n", r->name);
 		return 0;
