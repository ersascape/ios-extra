+/* RSCC offsets are mainline a6xx_gmu.xml dword indexes (x4) from gmu+0x23000; the two
+ * RSCC handshake registers are GMU-block indexes 0x9307/0x9308. */
+static const struct { const char *name; uint32_t off; } gpu_rsc_regs[GPU_RSC_READS] = {
+	{ "RSC_STATUS0_DRV0", GPU_RSCC_BASE + 0x0004 * 4 },
+	{ "PDC_SEQ_START_ADDR", GPU_RSCC_BASE + 0x0008 * 4 },
+	{ "PDC_MATCH_VALUE_LO", GPU_RSCC_BASE + 0x0009 * 4 },
+	{ "PDC_MATCH_VALUE_HI", GPU_RSCC_BASE + 0x000a * 4 },
+	{ "PDC_SLAVE_ID_DRV0", GPU_RSCC_BASE + 0x000b * 4 },
+	{ "HIDDEN_TCS_CMD0_ADDR", GPU_RSCC_BASE + 0x000d * 4 },
+	{ "HIDDEN_TCS_CMD0_DATA", GPU_RSCC_BASE + 0x000e * 4 },
+	{ "OVERRIDE_START_ADDR", GPU_RSCC_BASE + 0x0100 * 4 },
+	{ "SEQ_BUSY_DRV0", GPU_RSCC_BASE + 0x0101 * 4 },
+	{ "SEQ_MEM_0_DRV0", GPU_RSCC_BASE + 0x0180 * 4 },
+	{ "TCS0_DRV0_STATUS", GPU_RSCC_BASE + 0x0346 * 4 },
+	{ "TCS3_DRV0_STATUS", GPU_RSCC_BASE + 0x053e * 4 },
+	{ "GMU_RSCC_CONTROL_REQ", 0x9307 * 4 },
+	{ "GMU_RSCC_CONTROL_ACK", 0x9308 * 4 },
+};
+/* gmu_pdc: ENABLE_PDC, SEQ_START_ADDR, TCS0 control, TCS1/TCS3 CMD_ENABLE_BANK and CMD0_ADDR. */
+static const struct { const char *name; uint32_t off; } gpu_pdc_regs[GPU_PDC_READS] = {
+	{ "GPU_ENABLE_PDC", 0x1140 * 4 }, { "GPU_SEQ_START_ADDR", 0x1148 * 4 },
+	{ "GPU_TCS0_CONTROL", 0x1540 * 4 }, { "GPU_TCS1_CMD_ENABLE_BANK", 0x1573 * 4 },
+	{ "GPU_TCS3_CMD_ENABLE_BANK", 0x15d7 * 4 }, { "GPU_TCS3_CMD0_ADDR", 0x15da * 4 },
+};
+
+static void
+gpu_rsc_read(vm_offset_t gmu, struct gpu_power_experiment *x)
+{
+	vm_offset_t pdc, seq;
+
+	x->rsc_requested = 1;
+	for (unsigned int i = 0; i < GPU_RSC_READS; i++) {
+		printf("SWEET GPU: reading RSC %s +0x%x\n", gpu_rsc_regs[i].name, gpu_rsc_regs[i].off);
+		x->rsc_value[i] = gpu_read32(gmu, gpu_rsc_regs[i].off);
+		x->rsc_done = i + 1;
+	}
+	pdc = ml_io_map(GPU_PDC_PA, GPU_PDC_SIZE);
+	if (pdc) {
+		x->pdc_mapped = 1;
+		for (unsigned int i = 0; i < GPU_PDC_READS; i++) {
+			printf("SWEET GPU: reading PDC %s +0x%x\n", gpu_pdc_regs[i].name, gpu_pdc_regs[i].off);
+			x->pdc_value[i] = gpu_read32(pdc, gpu_pdc_regs[i].off);
+			x->pdc_done = i + 1;
+		}
+	}
+	seq = ml_io_map(GPU_PDC_SEQ_PA, GPU_PDC_SIZE);
+	if (seq) {
+		x->seq_mapped = 1;
+		for (unsigned int i = 0; i < GPU_PDC_SEQ_READS; i++) {
+			printf("SWEET GPU: reading PDC SEQ_MEM_%u +0x%x\n", i, 4 * i);
+			x->seq_value[i] = gpu_read32(seq, 4 * i);
+			x->seq_done = i + 1;
+		}
+	}
+}
