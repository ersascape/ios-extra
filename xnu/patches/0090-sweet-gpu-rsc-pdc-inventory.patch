  * into context bank 3 with a small 4 KiB-granule table mapping IOVA 0x60000000 to
  * a kernel page, checks it with the SMMU's own address-translate (ATOS) and then
  * restores every SMMU register it touched. No master ever uses the mapping.
+ * sweetgpu=9 additionally reads (never writes) the GPU RSC/RSCC registers inside
+ * the GMU block and the two GPU PDC regions (0x0b290000, 0x0b490000) that mainline
+ * programs before booting the GMU, to see what ABL left there.
  * Register provenance and limitations: ios-extra/docs/GPU_BRINGUP.md.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
@@ -119,6 +122,13 @@ int sweet_rpmh_arc_set(const char *res, unsigned corner, unsigned *level);
 #define GPU_SMMU_GMU_IOVA       0x60000000u
 #define GPU_SMMU_TBL_BYTES      0x4000u
 #define GPU_SMMU_VERIFY         4u
+#define GPU_RSCC_BASE           0x23000u   /* gmu->rscc = gmu mmio + 0x23000 (mainline) */
+#define GPU_RSC_READS           14u
+#define GPU_PDC_PA              0x0b290000
+#define GPU_PDC_SEQ_PA          0x0b490000
+#define GPU_PDC_SIZE            0x00010000
+#define GPU_PDC_READS           6u
+#define GPU_PDC_SEQ_READS       5u
