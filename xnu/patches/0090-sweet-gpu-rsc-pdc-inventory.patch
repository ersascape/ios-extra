 	uint32_t ctx_fsr, ctx_gfsr, ctx_final[4];
+	/* sweetgpu=9: RSC/PDC read-only inventory (done = reads completed per group). */
+	unsigned int rsc_requested, rsc_done, pdc_mapped, pdc_done, seq_mapped, seq_done;
+	uint32_t rsc_value[GPU_RSC_READS], pdc_value[GPU_PDC_READS], seq_value[GPU_PDC_SEQ_READS];
 	/* Write transcript: every SMMU write with its immediate readback. */
