diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -2250,2 +2250,3 @@
+static void fp6_smmu_inventory(void);
 static void
 fp6_adreno_startup(void)
@@ -2257,2 +2258,3 @@
-	fp6_qcom_pas_zap_load();
+	fp6_qcom_pas_zap_load();
+	fp6_smmu_inventory();
 }
@@ -2260,0 +2261,125 @@
+
+/* Read-only inspection of the dedicated FP6 qsmmu-v500. It does not claim
+ * SID ownership, allocate a context, issue ATOS, or change SMMU state. */
+#if defined(ARM64_BOARD_CONFIG_FP6)
+#define FP6_GPU_SMMU_PA       0x03da0000u
+#define FP6_GPU_SMMU_SIZE     0x00040000u
+#define FP6_SMMU_IDR0         0x0020u
+#define FP6_SMMU_IDR1         0x0024u
+#define FP6_SMMU_IDR2         0x0028u
+#define FP6_SMMU_IDR7         0x003cu
+#define FP6_SMMU_GFSR         0x0048u
+#define FP6_SMMU_SCR0         0x0000u
+#define FP6_SMMU_SMR(n)       (0x0800u + 4u * (n))
+#define FP6_SMMU_S2CR(n)      (0x0c00u + 4u * (n))
+#define FP6_SMMU_CBAR(n)      (FP6_SMMU_GR1 + 4u * (n))
+#define FP6_SMMU_CBA2R(n)     (FP6_SMMU_GR1 + 0x0800u + 4u * (n))
+#define FP6_SMMU_CB_SCTLR     0x0000u
+#define FP6_SMMU_CB_TCR2      0x0010u
+#define FP6_SMMU_CB_TTBR0     0x0020u
+#define FP6_SMMU_CB_TCR       0x0030u
+#define FP6_SMMU_ID0_SMS      (1u << 27)
+#define FP6_SMMU_ID0_NUMSMRG  0xffu
+#define FP6_SMMU_ID1_PAGESIZE (1u << 31)
+#define FP6_SMMU_SMR_VALID    (1u << 31)
+#define FP6_SMMU_MAX_STREAMS  128u
+#define FP6_SMMU_MAX_CBS      128u
+
+static uint32_t
+fp6_smmu_read32(vm_offset_t base, uint32_t off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+fp6_smmu_inventory(void)
+{
+	int mode = 0;
+	if (!PE_parse_boot_argn("fp6smmu", &mode, sizeof(mode)) || mode == 0)
+		return;
+	if (mode != 1) {
+		printf("QCOM SMMU: unsupported fp6smmu=%d (0=off, 1=read-only inventory)\n", mode);
+		return;
+	}
+
+	vm_offset_t base = ml_io_map(FP6_GPU_SMMU_PA, FP6_GPU_SMMU_SIZE);
+	if (base == 0) {
+		printf("QCOM SMMU: qsmmu-v500 map failed; no writes attempted\n");
+		return;
+	}
+	uint32_t id0 = fp6_smmu_read32(base, FP6_SMMU_IDR0);
+	uint32_t id1 = fp6_smmu_read32(base, FP6_SMMU_IDR1);
+	uint32_t id2 = fp6_smmu_read32(base, FP6_SMMU_IDR2);
+	uint32_t id7 = fp6_smmu_read32(base, FP6_SMMU_IDR7);
+	uint32_t scr0 = fp6_smmu_read32(base, FP6_SMMU_SCR0);
+	uint32_t gfsr = fp6_smmu_read32(base, FP6_SMMU_GFSR);
+	unsigned numsmrg = id0 & FP6_SMMU_ID0_NUMSMRG;
+	unsigned numcb = id1 & 0xffu;
+	unsigned pgshift = (id1 & FP6_SMMU_ID1_PAGESIZE) ? 16u : 12u;
+	unsigned numpages = 1u << (((id1 >> 28) & 7u) + 1u);
+	uint64_t cb_base = (uint64_t)numpages << pgshift;
+	uint32_t gr1 = 1u << pgshift;
+
+	printf("QCOM SMMU: qsmmu-v500 read-only inventory PA=0x%08x size=0x%x\n",
+	    FP6_GPU_SMMU_PA, FP6_GPU_SMMU_SIZE);
+	printf("QCOM SMMU: IDR0=0x%08x IDR1=0x%08x IDR2=0x%08x IDR7=0x%08x sCR0=0x%08x sGFSR=0x%08x\n",
+	    id0, id1, id2, id7, scr0, gfsr);
+	if (id0 == 0xffffffffu || id1 == 0xffffffffu || id2 == 0xffffffffu ||
+	    numcb > FP6_SMMU_MAX_CBS || numsmrg > FP6_SMMU_MAX_STREAMS) {
+		printf("QCOM SMMU: invalid identification or geometry; route scan refused\n");
+		return;
+	}
+	printf("QCOM SMMU: stream_match=%u groups=%u context_banks=%u page_shift=%u cb_base=0x%llx\n",
+	    !!(id0 & FP6_SMMU_ID0_SMS), numsmrg, numcb, pgshift,
+	    (unsigned long long)cb_base);
+
+	if (id0 & FP6_SMMU_ID0_SMS) {
+		for (unsigned i = 0; i < numsmrg; i++) {
+			uint32_t smr = fp6_smmu_read32(base, FP6_SMMU_SMR(i));
+			uint32_t s2cr = fp6_smmu_read32(base, FP6_SMMU_S2CR(i));
+			unsigned valid = !!(smr & FP6_SMMU_SMR_VALID);
+			unsigned sid = smr & 0xffffu;
+			unsigned mask = (smr >> 16) & 0x7fffu;
+			unsigned type = (s2cr >> 16) & 3u;
+			unsigned cb = s2cr & 0xffu;
+			const char *route = type == 0 ? "translate" : type == 1 ? "bypass" :
+				    type == 2 ? "fault" : "reserved";
+			unsigned sid0 = valid && (((sid ^ 0u) & ~mask & 0xffffu) == 0);
+			unsigned sid2 = valid && (((sid ^ 2u) & ~mask & 0xffffu) == 0);
+			unsigned sid5 = valid && (((sid ^ 5u) & ~mask & 0xffffu) == 0);
+			printf("QCOM SMMU: group=%u valid=%u SMR=0x%08x ID=0x%x MASK=0x%x S2CR=0x%08x route=%s CB=%u matches[0,2,5]=%u,%u,%u\n",
+				    i, valid, smr, sid, mask, s2cr, route, cb, sid0, sid2, sid5);
+		}
+	} else {
+		printf("QCOM SMMU: stream-index mode; no SMR groups to scan\n");
+	}
+	unsigned active_cbs = 0;
+	for (unsigned cb = 0; cb < numcb; cb++) {
+		uint32_t cbar_off = gr1 + 4u * cb;
+		uint32_t cba2r_off = gr1 + 0x0800u + 4u * cb;
+		uint64_t cb_off = cb_base + ((uint64_t)cb << pgshift);
+		if (cba2r_off > FP6_GPU_SMMU_SIZE - 4u ||
+		    cbar_off > FP6_GPU_SMMU_SIZE - 4u ||
+		    cb_off + FP6_SMMU_CB_TCR + 4u > FP6_GPU_SMMU_SIZE) {
+			printf("QCOM SMMU: CB%u context window outside mapping; skipped\n", cb);
+			continue;
+		}
+		uint32_t cbar = fp6_smmu_read32(base, cbar_off);
+		uint32_t cba2r = fp6_smmu_read32(base, cba2r_off);
+		uint32_t sctlr = fp6_smmu_read32(base, (uint32_t)cb_off + FP6_SMMU_CB_SCTLR);
+		uint32_t tcr2 = fp6_smmu_read32(base, (uint32_t)cb_off + FP6_SMMU_CB_TCR2);
+		uint32_t ttbr0_lo = fp6_smmu_read32(base, (uint32_t)cb_off + FP6_SMMU_CB_TTBR0);
+		uint32_t ttbr0_hi = fp6_smmu_read32(base, (uint32_t)cb_off + FP6_SMMU_CB_TTBR0 + 4u);
+		uint32_t tcr = fp6_smmu_read32(base, (uint32_t)cb_off + FP6_SMMU_CB_TCR);
+		if (cbar || cba2r || sctlr || tcr2 || ttbr0_lo || ttbr0_hi || tcr) {
+			printf("QCOM SMMU: CB%u CBAR=0x%08x CBA2R=0x%08x SCTLR=0x%08x TCR2=0x%08x TTBR0=0x%08x%08x TCR=0x%08x\n",
+				    cb, cbar, cba2r, sctlr, tcr2, ttbr0_hi, ttbr0_lo, tcr);
+			active_cbs++;
+		}
+	}
+	printf("QCOM SMMU: context banks with nonzero state=%u/%u\n", active_cbs, numcb);
+	printf("QCOM SMMU: read-only inventory complete; no writes or ATOS requests\n");
+}
+#endif /* ARM64_BOARD_CONFIG_FP6 */
