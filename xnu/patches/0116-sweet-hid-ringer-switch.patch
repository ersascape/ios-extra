 void
-SweetHIDButtons::key(UInt32 usage, bool down)
+SweetHIDButtons::key(UInt32 page, UInt32 usage, bool down)
 {
-	IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(), kHIDPage_Consumer, usage, down);
+	if (page == kHIDPage_Telephony && usage == kHIDUsage_Tfon_RingEnable) {
+		fRinger = down ? 1 : 0;
+	}
+	IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(), page, usage, down);
 
 	if (event) {
-		IOLog("SWEET HID: key 0x%x %s (%u clients)\n", (unsigned)usage, down ? "down" : "up",
