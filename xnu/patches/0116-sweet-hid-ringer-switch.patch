+		IOLog("SWEET HID: key 0x%x/0x%x %s (%u clients)\n", (unsigned)page, (unsigned)usage,
+		    down ? "down" : "up", _clients ? _clients->getCount() : 0);
 		dispatchEvent(event);
 		event->release();
 	}
 }
 
+bool
+SweetHIDButtons::open(IOService *client, IOOptionBits options, void *context, Action action)
+{
+	if (!IOHIDEventService::open(client, options, context, action)) {
+		return false;
+	}
+	if (fRinger >= 0) {
+		key(kHIDPage_Telephony, kHIDUsage_Tfon_RingEnable, fRinger != 0);
+	}
+	return true;
+}
+
+IOHIDEvent *
+SweetHIDButtons::copyEvent(IOHIDEventType type, IOHIDEvent *matching, IOOptionBits options __unused)
+{
+	if (type != kIOHIDEventTypeKeyboard || fRinger < 0) {
+		return NULL;
+	}
+	if (matching &&
+	    ((UInt32)matching->getIntegerValue(kIOHIDEventFieldKeyboardUsagePage) != kHIDPage_Telephony ||
+	    (UInt32)matching->getIntegerValue(kIOHIDEventFieldKeyboardUsage) != kHIDUsage_Tfon_RingEnable)) {
+		return NULL;
+	}
+	return IOHIDEvent::keyboardEvent(mach_absolute_time(), kHIDPage_Telephony,
+	           kHIDUsage_Tfon_RingEnable, fRinger != 0);
+}
