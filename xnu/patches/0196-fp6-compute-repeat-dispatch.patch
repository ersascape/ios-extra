+	for (unsigned iteration = 1; iteration <= (unsigned)wanted; iteration++) {
+		if (!fp6_gpu_compute_submit(g, gpu, iteration)) {
+			printf("QCOM GPU COMPUTE: stopped at run %u of %d\n", iteration, wanted);
+			return 0;
+		}
+	}
+	printf("QCOM GPU COMPUTE: %d back-to-back runs passed\n", wanted);
+	return 1;
