+/* Read-only: wake/stop must already have returned to the measured reset state. */
+static void
+gpu_gmu_irq_preflight(vm_offset_t gmu, struct gpu_power_experiment *x)
+{
+	x->irq_preflight_requested = 1;
+	if (x->wake.error || !x->wake.ack_done || !x->wake.busy_done || !x->wake.stop_done ||
+	    !x->wake.controls_restored || !x->wake.state_restored ||
+	    x->preboot_error || x->preboot_done != GPU_PREBOOT_READS ||
+	    x->buf.error || !x->buf.inactive || x->buf.passed != GPU_BUF_CHECKS) {
+		x->irq_preflight_error = "prior pre-boot/map/wake proof incomplete; IRQ dump skipped";
+		return;
+	}
+	if (gpu_read32(gmu, 0x14000) != 1 || gpu_read32(gmu, 0x14068) != 0) {
+		x->irq_preflight_error = "CM3 not held reset/idle; IRQ dump skipped";
+		return;
+	}
+	for (unsigned int i = 0; i < GPU_IRQ_PREFLIGHT_READS; i++) {
+		printf("SWEET GPU: reading IRQ preflight %s +0x%x\n", gpu_irq_preflight_regs[i].name, gpu_irq_preflight_regs[i].off);
+		x->irq_preflight_value[i] = gpu_read32(gmu, gpu_irq_preflight_regs[i].off);
+		x->irq_preflight_done = i + 1;
+	}
+}
