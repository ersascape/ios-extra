-		    r->name, ring != NULL, (unsigned long long)size, rptr, wptr);
+	/* The BR read pointer can lag after BV/BR sync work; an idle GPU is quiescent. */
+	if (!ring || (rptr != wptr && fp6_smmu_read32(gpu, 0x48u) != 1u) ||
+	    (uint64_t)wptr + n >= size || size * 4u > ring->desc[7]) {
+		printf("QCOM GPU REPLAY: %s ring unavailable (ring=%u size=%llu rptr=%u wptr=%u rbbm=0x%08x)\n",
+		    r->name, ring != NULL, (unsigned long long)size, rptr, wptr, fp6_smmu_read32(gpu, 0x48u));
 		return 0;
 	}
 	volatile uint32_t *fence = (volatile uint32_t *)(void *)(fp6_exec_result.va + 4u * FP6_REPLAY_FENCE_OFFSET);
@@ -4995,18 +4999,21 @@
 		dropped = fp6_smmu_read32(g, FP6_GMU_AHB_FENCE_STATUS) & 1u;
