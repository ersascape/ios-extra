+++ b/bsd/dev/sweet_gpu.c
@@ -4922,6 +4922,8 @@
 #define FP6_REPLAY_FENCE_OFFSET 0x100u /* dword index in the result page */
 #define FP6_REPLAY_FENCE_VALUE 0x600dcafeu
 
+static uint32_t fp6_replay_last_rbbm, fp6_replay_last_bv_rptr;
+
 /* Submit one CP_INDIRECT_BUFFER of the first ib_dwords of the capture's stream
