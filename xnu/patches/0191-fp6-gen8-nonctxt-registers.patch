+	{ 0x017b0u, 0x00000001u, 0x1u }, /* RBBM_SLICE_NC_MODE_CNTL */
+	{ 0x00040u, 0x00000030u, 0x1u }, /* RBBM_WAIT_IDLE_CLOCKS_CNTL */
+	{ 0x00044u, 0x00000030u, 0x1u }, /* RBBM_WAIT_IDLE_CLOCKS_CNTL2 */
+	{ 0x03848u, 0x010240e0u, 0x1u }, /* UCHE_GBIF_GX_CONFIG */
+	{ 0x00020u, 0x22122212u, 0x1u }, /* RBBM_GBIF_CLIENT_QOS_CNTL */
+	{ 0x00274u, 0x00000040u, 0x1u }, /* RBBM_CGC_P2S_CNTL */
+	{ 0x2b824u, 0x00c00000u, 0x1u }, /* SP_CHICKEN_BITS_2 */
+	{ 0x2b828u, 0x00300000u, 0x1u }, /* SP_CHICKEN_BITS_3 */
+	{ 0x2b83cu, 0x0000003fu, 0x1u }, /* SP_PERFCTR_SHADER_MASK */
+	{ 0x2b9acu, 0x00000080u, 0x1u }, /* SP_HLSQ_TIMEOUT_THRESHOLD_DP */
+	{ 0x2d800u, 0x10000000u, 0x1u }, /* TPL1_DBG_ECO_CNTL */
+	{ 0x2d808u, 0x04000724u, 0x1u }, /* TPL1_DBG_ECO_CNTL1 */
+	{ 0x03804u, 0x00020000u, 0x1u }, /* UCHE_MODE_CNTL */
+	{ 0x03c04u, 0x00001000u, 0x1u }, /* UCHE_CCHE_MODE_CNTL */
