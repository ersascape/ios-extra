+};
+static void
+fp6_gpu_program_nonctxt(vm_offset_t gpu)
+{
+	unsigned written = 0;
+	for (uint32_t pipe = 0; pipe <= 2u; pipe++) {
+		fp6_smmu_write32(gpu, FP6_GPU_CP_APERTURE_CNTL_HOST, pipe << 12);
+		for (unsigned i = 0; i < sizeof(fp6_gpu_nonctxt_regs) / sizeof(fp6_gpu_nonctxt_regs[0]); i++) {
+			if (fp6_gpu_nonctxt_regs[i].pipes & (1u << pipe)) {
+				fp6_smmu_write32(gpu, fp6_gpu_nonctxt_regs[i].offset,
+				    fp6_gpu_nonctxt_regs[i].value);
+				written++;
+			}
+		}
+	}
+	fp6_smmu_write32(gpu, FP6_GPU_CP_APERTURE_CNTL_HOST, 0u);
+	printf("QCOM GPU EXEC: nonctxt registers written=%u of %u table entries\n", written,
+	    (unsigned)(sizeof(fp6_gpu_nonctxt_regs) / sizeof(fp6_gpu_nonctxt_regs[0])));
+}
