+/* Linux gen8_3_0_nonctxt_regs[] (adreno-gpulist.h), applied by
+ * gen8_nonctxt_regconfig() once per listed pipe through the CP aperture.
+ * Pipe mask bits: 0 NONE, 1 BR, 2 BV. The LPAC stream-id entry is omitted
+ * because A810 does not enable LPAC. Offsets are byte offsets (dword * 4). */
+struct fp6_gpu_nonctxt_reg { uint32_t offset, value, pipes; };
+static const struct fp6_gpu_nonctxt_reg fp6_gpu_nonctxt_regs[] = {
+	{ 0x21c08u, 0x00f80800u, 0x6u }, /* GRAS_DBG_ECO_CNTL */
+	{ 0x27828u, 0x00000001u, 0x6u }, /* PC_AUTO_VERTEX_STRIDE */
+	{ 0x27834u, 0x10010000u, 0x6u }, /* PC_VIS_STREAM_CNTL */
+	{ 0x27990u, 0x00000002u, 0x6u }, /* PC_CONTEXT_SWITCH_STABILIZE_CNTL_1 */
+	{ 0x27940u, 0x00000003u, 0x2u }, /* PC_CHICKEN_BITS_1 */
+	{ 0x27940u, 0x00000023u, 0x4u }, /* PC_CHICKEN_BITS_1 */
+	{ 0x27c80u, 0x00000200u, 0x6u }, /* PC_CHICKEN_BITS_2 */
+	{ 0x27888u, 0x00500000u, 0x6u }, /* PC_CHICKEN_BITS_3 */
+	{ 0x2788cu, 0x00500050u, 0x6u }, /* PC_CHICKEN_BITS_4 */
