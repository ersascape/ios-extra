diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -812,6 +812,7 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 	static char chunk[1400];
 	socket_t so = NULL;
 	struct sockaddr_in to;
+	uint32_t socket_errors = 0, send_errors = 0;
 	uint64_t pos = sweet_log_position();
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	uint32_t gpu_report_ticks = 0;
@@ -821,6 +822,7 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 	to.sin_family = AF_INET;
 	to.sin_port = htons(5140);
 	to.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	printf("SWEET USB LOG: sender thread started at ring offset %llu\n", pos);
 	for (;;) {
 		ud_sleep_ms(100);
 		if (!ud.configured) {
@@ -839,20 +841,39 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 		}
 #endif
-		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
-			so = NULL;
-			continue;
+		if (so == NULL) {
+			errno_t err = sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so);
+			if (err != 0) {
+				so = NULL;
+				if ((++socket_errors % 50) == 1) {
+					printf("SWEET USB LOG: UDP socket creation failed, err %d\n", err);
+				}
+				continue;
+			}
+			printf("SWEET USB LOG: UDP socket ready for 192.168.7.1:5140\n");
 		}
 		uint32_t n;
-		while ((n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+		while (1) {
+			uint64_t next_pos = pos;
+			n = sweet_log_copy(&next_pos, chunk, sizeof(chunk));
+			if (n == 0) {
+				break;
+			}
 			struct iovec iov = { .iov_base = chunk, .iov_len = n };
 			struct msghdr msg = {
 				.msg_name = &to, .msg_namelen = sizeof(to),
 				.msg_iov = &iov, .msg_iovlen = 1,
 			};
 			size_t sent = 0;
-			if (sock_send(so, &msg, 0, &sent) != 0) {
-				break;          /* no route/ARP yet: retry later */
+			errno_t err = sock_send(so, &msg, 0, &sent);
+			if (err != 0 || sent != n) {
+				if ((++send_errors % 50) == 1) {
+					printf("SWEET USB LOG: UDP send failed, err %d sent %lu/%u bytes\n",
+					    err, (unsigned long)sent, n);
+				}
+				break;          /* retain pos and retry after route/ARP recovers */
 			}
+			pos = next_pos;
+			send_errors = 0;
 		}
 	}
 }
@@ -936,7 +956,14 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	int livelog = 1;
 	PE_parse_boot_argn("sweetusblog", &livelog, sizeof(livelog));
-	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
-		thread_deallocate(thread);
+	if (livelog && ud.ifp != NULL) {
+		kern_return_t kr = kernel_thread_start(ud_log_thread, NULL, &thread);
+		if (kr == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			printf("SWEET USB LOG: sender thread creation failed, kr %d\n", kr);
+		}
+	} else if (livelog) {
+		printf("SWEET USB LOG: sender not started, ue0 is unavailable\n");
 	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_FP6 */
