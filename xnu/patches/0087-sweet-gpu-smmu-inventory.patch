+	unsigned int smmu_mapped, smmu_gr0_done, smmu_nsmr, smmu_ncb;
+	uint32_t smmu_gr0[GPU_SMMU_GR0], smmu_smr[GPU_SMMU_MAXSMR], smmu_s2cr[GPU_SMMU_MAXSMR];
