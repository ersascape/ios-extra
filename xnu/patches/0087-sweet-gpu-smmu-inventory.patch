@@ -569,6 +632,23 @@ gpu_power_log(const struct gpu_power_experiment *x)
 			printf("SWEET GPU: GMU fw result: %s\n", x->fw_error ? x->fw_error : "TCM readback matches; CM3 left in reset");
 		}
 	}
+	if (x->smmu_mapped) {
+		for (unsigned int i = 0; i < x->smmu_gr0_done; i++) {
+			printf("SWEET GPU: SMMU %s +0x%x = 0x%08x\n", gpu_smmu_gr0[i].name,
+			    gpu_smmu_gr0[i].off, x->smmu_gr0[i]);
+		}
+		for (unsigned int i = 0; i < x->smmu_nsmr; i++) {
+			printf("SWEET GPU: SMMU SMR%u = 0x%08x S2CR%u = 0x%08x\n", i, x->smmu_smr[i], i, x->smmu_s2cr[i]);
+		}
+		for (unsigned int i = 0; i < x->smmu_ncb; i++) {
+			printf("SWEET GPU: SMMU CBAR%u = 0x%08x\n", i, x->smmu_cbar[i]);
+		}
+		if (x->smmu_ncb > 0) {
+			printf("SWEET GPU: SMMU CB0 SCTLR=0x%08x TTBR0=0x%08x TCR=0x%08x FSR=0x%08x\n",
+			    x->smmu_cb[0], x->smmu_cb[1], x->smmu_cb[2], x->smmu_cb[3]);
+		}
+		printf("SWEET GPU: SMMU micro-mmu +0x6000 = 0x%08x (read-only inventory)\n", x->smmu_micro);
+	}
 	printf("SWEET GPU: GMU clk stage=%u restored=%u result: %s\n", x->clk_stage,
 	    x->clk_restored, x->clk_error ? x->clk_error : "complete, rolled back");
 }
