  * sweetgpu=6 additionally copies the GMU firmware (linux-firmware a630_gmu.bin,
  * staged by 0086-stage-gpu-firmware.sh) into the GMU ITCM/DTCM and reads it back,
  * only while the CM3 is verified to be held in reset. The CM3 is never released.
+ * sweetgpu=7 additionally maps the GPU SMMU (0x05040000, needs the same two GCC
+ * bus branches) and reads its global/ID registers, the first stream mapping
+ * entries and context bank 0, read-only, inside the same window.
  * Register provenance and limitations: ios-extra/docs/GPU_BRINGUP.md.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
@@ -78,6 +81,16 @@ int sweet_rpmh_arc_set(const char *res, unsigned corner, unsigned *level);
 #define GPU_GMU_READS           6u
 #define GPU_GMU_TCM             0x3000u   /* ITCM_START 0x1B400; DTCM follows at +0x4000 */
 #define GPU_GMU_FW_MAX          0x8000u
+#define GPU_SMMU_PA             0x05040000
+#define GPU_SMMU_SIZE           0x00010000
+#define GPU_SMMU_GR0            10u
+#define GPU_SMMU_MAXSMR         8u
+#define GPU_SMMU_MAXCB          4u
+#define GPU_SMMU_SMR            0x0800u
+#define GPU_SMMU_S2CR           0x0c00u
+#define GPU_SMMU_CBAR           0x1000u
+#define GPU_SMMU_CB0            0x8000u   /* gfx3d_user: DT gpu-offset 0x48000 = SMMU+0x8000 */
+#define GPU_SMMU_MICRO          0x6000u   /* DT qcom,micro-mmu-control */
 #define GPU_GDSC_HOLD_US        1000u
 
