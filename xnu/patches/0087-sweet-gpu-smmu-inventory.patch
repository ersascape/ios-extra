@@ -337,6 +354,49 @@ gpu_gmu_fw_load(vm_offset_t gmu, struct gpu_power_experiment *x)
 	}
 }
 
+static const struct { const char *name; uint32_t off; } gpu_smmu_gr0[GPU_SMMU_GR0] = {
+	{ "sCR0", 0x00 }, { "sCR1", 0x04 }, { "sCR2", 0x08 }, { "sACR", 0x10 },
+	{ "IDR0", 0x20 }, { "IDR1", 0x24 }, { "IDR2", 0x28 }, { "IDR7", 0x3c },
+	{ "sGFSR", 0x48 }, { "sGFSYNR0", 0x50 },
+};
+/* Context bank 0 registers read: SCTLR, TTBR0 low, TCR, FSR. */
+static const uint32_t gpu_smmu_cb0[GPU_SMMU_MAXCB] = { 0x00, 0x20, 0x30, 0x58 };
+
+static void
+gpu_smmu_read(struct gpu_power_experiment *x)
+{
+	vm_offset_t smmu = ml_io_map(GPU_SMMU_PA, GPU_SMMU_SIZE);
+	unsigned int nsmr, ncb;
+
+	if (!smmu) {
+		return;
+	}
+	x->smmu_mapped = 1;
+	for (unsigned int i = 0; i < GPU_SMMU_GR0; i++) {
+		printf("SWEET GPU: reading SMMU %s +0x%x\n", gpu_smmu_gr0[i].name, gpu_smmu_gr0[i].off);
+		x->smmu_gr0[i] = gpu_read32(smmu, gpu_smmu_gr0[i].off);
+		x->smmu_gr0_done = i + 1;
+	}
+	/* Counts come from the hardware ID registers (IDR0.NUMSMRG, IDR1.NUMCB). */
+	nsmr = x->smmu_gr0[4] == ~0u ? 0 : x->smmu_gr0[4] & 0xffu;
+	ncb = x->smmu_gr0[5] == ~0u ? 0 : x->smmu_gr0[5] & 0xffu;
+	x->smmu_nsmr = nsmr < GPU_SMMU_MAXSMR ? nsmr : GPU_SMMU_MAXSMR;
+	x->smmu_ncb = ncb < GPU_SMMU_MAXCB ? ncb : GPU_SMMU_MAXCB;
+	for (unsigned int i = 0; i < x->smmu_nsmr; i++) {
+		x->smmu_smr[i] = gpu_read32(smmu, GPU_SMMU_SMR + 4 * i);
+		x->smmu_s2cr[i] = gpu_read32(smmu, GPU_SMMU_S2CR + 4 * i);
+	}
+	for (unsigned int i = 0; i < x->smmu_ncb; i++) {
+		x->smmu_cbar[i] = gpu_read32(smmu, GPU_SMMU_CBAR + 4 * i);
+	}
+	if (x->smmu_ncb > 0) {
+		for (unsigned int i = 0; i < GPU_SMMU_MAXCB; i++) {
+			x->smmu_cb[i] = gpu_read32(smmu, GPU_SMMU_CB0 + gpu_smmu_cb0[i]);
+		}
+	}
+	x->smmu_micro = gpu_read32(smmu, GPU_SMMU_MICRO);
+}
+
 static void
 gpu_gmu_read(struct gpu_power_experiment *x, int mode)
 {
@@ -355,6 +415,9 @@ gpu_gmu_read(struct gpu_power_experiment *x, int mode)
 	if (mode >= 6) {
 		gpu_gmu_fw_load(gmu, x);
 	}
+	if (mode >= 7) {
+		gpu_smmu_read(x);
+	}
 }
 
