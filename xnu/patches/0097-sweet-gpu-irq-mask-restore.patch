+/* All-ones masks match mainline a6xx_gmu_irq_disable(); never enable an IRQ. */
+static int
+gpu_irq_mask_set(vm_offset_t gmu, struct gpu_irq_mask_probe *m, uint32_t off, uint32_t value)
+{
+	gpu_write32(gmu, off, value);
+	uint32_t got = gpu_read32(gmu, off);
+	if (m->nwrites < 6) {
+		unsigned int n = m->nwrites++;
+		m->off[n] = off; m->wrote[n] = value; m->got[n] = got;
+	}
+	return got == value;
+}
+
+static void
+gpu_gmu_irq_mask_test(vm_offset_t gmu, vm_offset_t cc, struct gpu_power_experiment *x)
+{
+	struct gpu_irq_mask_probe *m = &x->irq_mask;
+	m->requested = 1;
+	if (x->irq_preflight_error || x->irq_preflight_done != GPU_IRQ_PREFLIGHT_READS) {
+		m->error = "IRQ preflight incomplete; no mask writes";
+		return;
+	}
+	for (unsigned int i = 0; i < GPU_IRQ_PREFLIGHT_READS; i++) {
+		if (x->irq_preflight_value[i] != gpu_irq_expected[i] ||
+		    gpu_read32(gmu, gpu_irq_preflight_regs[i].off) != gpu_irq_expected[i]) {
+			m->error = "live/cached IRQ state differs from measured 0096; no mask writes";
+			return;
+		}
+	}
+	if (gpu_read32(gmu, 0x14000) != 1 || gpu_read32(gmu, 0x14068) != 0 || gpu_read32(gmu, 0x14070) != 0) {
+		m->error = "CM3 not held reset/idle/uninitialized; no mask writes";
+		return;
+	}
+	m->gx_before = gpu_read32(cc, GPU_GX_GDSCR);
+	if (m->gx_before == ~0u || (m->gx_before & GPU_DOMAIN_ON) || !(m->gx_before & GPU_GDSC_SW_COLLAPSE)) {
+		m->error = "GX not off/collapsed; no mask writes";
+		return;
+	}
+	printf("SWEET GPU: testing both GMU interrupt masks; CM3 held reset\n");
+	for (unsigned int i = 0; i < 2; i++) {
+		m->attempted = i + 1;
+		if (!gpu_irq_mask_set(gmu, m, gpu_irq_preflight_regs[i].off, ~0u)) {
+			m->error = "interrupt mask write did not read back";
+			break;
+		}
+		m->masked++;
+	}
+	for (unsigned int i = 0; i < 2; i++) m->masked_value[i] = gpu_read32(gmu, gpu_irq_preflight_regs[i].off);
+	m->reset = gpu_read32(gmu, 0x14000); m->busy = gpu_read32(gmu, 0x14068); m->init = gpu_read32(gmu, 0x14070);
+	/* Never restore unmasked defaults over an unexpected pending source or reset loss.
+	 * No clear register is written: preserve evidence and leave both sources masked. */
+	if (m->reset != 1 || m->busy != 0 || m->init != 0 ||
+	    gpu_read32(gmu, 0x14648) != 0 || gpu_read32(gmu, 0x24c14) != 0) {
+		m->quarantined = 1;
+		m->error = "reset/idle/status changed; masking requested, rollback incomplete";
+		for (unsigned int i = 0; i < 2; i++) (void)gpu_irq_mask_set(gmu, m, gpu_irq_preflight_regs[i].off, ~0u);
+	} else {
+		m->restored = 1;
+		for (unsigned int i = m->attempted; i > 0; i--)
+			if (!gpu_irq_mask_set(gmu, m, gpu_irq_preflight_regs[i-1].off, 0)) m->restored = 0;
+	}
+	for (unsigned int i = 0; i < GPU_IRQ_PREFLIGHT_READS; i++) {
+		m->final[i] = gpu_read32(gmu, gpu_irq_preflight_regs[i].off);
+		if (m->final[i] != gpu_irq_expected[i]) m->restored = 0;
+	}
+	m->gx_final = gpu_read32(cc, GPU_GX_GDSCR);
+	if (m->gx_final != m->gx_before || gpu_read32(gmu, 0x14000) != 1 ||
+	    gpu_read32(gmu, 0x14068) != 0 || gpu_read32(gmu, 0x14070) != 0) m->restored = 0;
+	if (!m->restored && !m->quarantined) m->error = "IRQ/reset/GX state not fully restored";
+}
