+static int
+gpu_db_range(uint32_t size, uint32_t off, uint32_t length)
+{
+	return off <= size && length <= size - off;
+}
+
+/* Callers validate the two-byte range. Use aligned 32-bit Device loads,
+ * including when a uint16_t crosses a word boundary in auxiliary data. */
+static uint16_t
+gpu_db_read16(vm_offset_t db, uint32_t off)
+{
+	uint32_t word = gpu_read32(db, off & ~3u);
+	unsigned int shift = (off & 3u) * 8u;
+	uint16_t value = (uint16_t)(word >> shift);
+	if (shift == 24u) {
+		value |= (uint16_t)((gpu_read32(db, (off & ~3u) + 4u) & 0xffu) << 8);
+	}
+	return value;
+}
+
+static void
+gpu_arc_collect(struct gpu_arc_inventory *arc)
+{
+	vm_offset_t locator, db;
+	uint32_t keys[GPU_ARC_RESOURCES][2] = {{0}};
+
+	arc->requested = 1;
+	arc->error = "locator mapping failed";
+	locator = ml_io_map(GPU_DB_LOCATOR_PA, 8);
+	if (!locator) {
+		return;
+	}
+	arc->pa = gpu_read32(locator, 0);
+	arc->size = gpu_read32(locator, 4);
+	arc->error = "invalid locator";
+	/* Match the existing board client's reserved-RAM locator policy. */
+	if (arc->pa < 0x80000000u || (arc->pa & 3u) || (arc->size & 3u) ||
+	    arc->size < GPU_DB_HEADER || arc->size > GPU_DB_MAX ||
+	    (uint64_t)arc->pa + arc->size > 0x100000000ULL) {
+		return;
+	}
+	arc->error = "database mapping failed";
+	db = ml_io_map(arc->pa, arc->size);
+	if (!db) {
+		return;
+	}
+	arc->version = gpu_read32(db, 0);
+	arc->magic = gpu_read32(db, 4);
+	arc->checksum = gpu_read32(db, 136);
+	arc->flags = gpu_read32(db, 140);
+	arc->error = "unsupported database header";
+	if (arc->version != 1 || arc->magic != GPU_DB_MAGIC || (arc->flags & 1u)) {
+		return;
+	}
+	for (unsigned int r = 0; r < GPU_ARC_RESOURCES; r++) {
+		for (unsigned int k = 0; k < 8 && gpu_arc_names[r][k]; k++) {
+			keys[r][k / 4] |= (uint32_t)(uint8_t)gpu_arc_names[r][k] << (8u * (k % 4));
+		}
+	}
+	/* Offsets in slave headers are relative to the data area at byte 144.
+	 * All table ranges are checked before any entry or auxiliary load. */
+	for (unsigned int i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned int slave = gpu_db_read16(db, h);
+		uint32_t entries, aux;
+		unsigned int count;
+		if (!slave) {
+			break;
+		}
+		entries = GPU_DB_HEADER + gpu_db_read16(db, h + 2);
+		aux = GPU_DB_HEADER + gpu_db_read16(db, h + 4);
+		count = gpu_db_read16(db, h + 6);
+		arc->error = "malformed slave table";
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !gpu_db_range(arc->size, entries, count * GPU_DB_ENTRY) ||
+		    !gpu_db_range(arc->size, aux, 0)) {
+			return;
+		}
+		for (unsigned int j = 0; j < count; j++) {
+			uint32_t e = entries + GPU_DB_ENTRY * j;
+			uint32_t key0 = gpu_read32(db, e), key1 = gpu_read32(db, e + 4);
+			for (unsigned int r = 0; r < GPU_ARC_RESOURCES; r++) {
+				struct gpu_arc_resource *resource = &arc->resource[r];
+				uint32_t data;
+				if (key0 != keys[r][0] || key1 != keys[r][1]) {
+					continue;
+				}
+				if (++resource->matches != 1) {
+					resource->error = "duplicate resource";
+					continue;
+				}
+				resource->address = gpu_read32(db, e + 16);
+				resource->priority[0] = gpu_read32(db, e + 8);
+				resource->priority[1] = gpu_read32(db, e + 12);
+				resource->version = gpu_db_read16(db, h + 8);
+				resource->bytes = gpu_db_read16(db, e + 20);
+				data = aux + gpu_db_read16(db, e + 22);
+				resource->error = "not an aligned ARC address";
+				if (slave != GPU_DB_ARC ||
+				    ((resource->address >> 16) & 7u) != GPU_DB_ARC ||
+				    (resource->address & 3u)) {
+					continue;
+				}
+				resource->error = "invalid level table range/length";
+				if (!resource->bytes || (resource->bytes & 1u) ||
+				    resource->bytes > GPU_ARC_LEVELS * 2u ||
+				    !gpu_db_range(arc->size, data, resource->bytes)) {
+					continue;
+				}
+				resource->count = resource->bytes / 2u;
+				for (unsigned int k = 0; k < resource->count; k++) {
+					resource->levels[k] = gpu_db_read16(db, data + 2u * k);
+				}
+				/* Preserve every raw entry, including trailing zero padding.
+				 * Ordering/corner policy belongs to a future voting client. */
+				resource->error = NULL;
+			}
+		}
+	}
+	arc->error = NULL;
+}
+
+static void
+gpu_arc_log(const struct gpu_arc_inventory *arc)
+{
+	if (!arc->requested) {
+		return;
+	}
+	printf("SWEET GPU: ARC cmd-db pa=0x%08x size=0x%x version=0x%x magic=0x%x checksum=0x%x flags=0x%x\n",
+	    arc->pa, arc->size, arc->version, arc->magic, arc->checksum, arc->flags);
+	if (arc->error) {
+		printf("SWEET GPU: ARC skipped: %s\n", arc->error);
+		return;
+	}
+	for (unsigned int r = 0; r < GPU_ARC_RESOURCES; r++) {
+		const struct gpu_arc_resource *resource = &arc->resource[r];
+		if (!resource->matches || resource->error) {
+			printf("SWEET GPU: ARC %s unavailable: %s (matches=%u)\n", gpu_arc_names[r],
+			    resource->matches ? resource->error : "resource missing", resource->matches);
+			continue;
+		}
+		printf("SWEET GPU: ARC %s addr=0x%08x aux-version=0x%x priority=0x%x:0x%x raw-levels=%u\n",
+		    gpu_arc_names[r], resource->address, resource->version,
+		    resource->priority[0], resource->priority[1], resource->count);
+		for (unsigned int k = 0; k < resource->count; k++) {
+			printf("SWEET GPU: ARC %s hlvl=%u vlvl=%u\n",
+			    gpu_arc_names[r], k, (unsigned int)resource->levels[k]);
+		}
+	}
+	printf("SWEET GPU: ARC raw metadata only; no votes or hardware writes\n");
+}
+
