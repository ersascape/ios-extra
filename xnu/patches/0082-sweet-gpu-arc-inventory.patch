+#define GPU_DB_HEADER           144u
+#define GPU_DB_ENTRY            24u
+#define GPU_DB_MAX              0x100000u
+#define GPU_DB_MAGIC            0x0c0330dbu
+#define GPU_DB_ARC              3u
+#define GPU_ARC_LEVELS          16u
+#define GPU_ARC_RESOURCES       3u
+
