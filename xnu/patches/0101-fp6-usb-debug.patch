 }
+
+/*
+ * FP6 shares the DWC3 core and Qualcomm QSCRATCH layout, but not SWEET GCC
+ * clock offsets. Keep this diagnostic opt-in: fp6usb=1 snapshots DWC3 handoff
+ * state; fp6usb=2 starts the polled ECM gadget and sends console logs to
+ * 192.168.7.1:5140. DMA/IOMMU behavior remains a phone measurement; this path
+ * does not alter SMMU registers.
+ */
+#if defined(ARM64_BOARD_CONFIG_FP6)
+void
+fp6_usb_probe(void)
+{
+	int mode = 0;
+	PE_parse_boot_argn("fp6usb", &mode, sizeof(mode));
+	if (mode == 0) {
+		return;
+	}
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (dwc == 0) {
+		printf("FP6 USB: DWC3 map failed\n");
+		return;
+	}
+	printf("FP6 USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x DCTL 0x%08x DSTS 0x%08x\n",
+	    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc118),
+	    usb_rd(dwc, 0xc704), usb_rd(dwc, 0xc70c));
+	if (mode >= 2) {
+		sweet_usb_gadget_start(dwc);
+	}
+}
+#endif
 
