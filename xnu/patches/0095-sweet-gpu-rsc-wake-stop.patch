+/* Accept only the specific readback signatures observed on 0092 through 0094.
+ * This is a gate for a wake experiment, not proof of correct PDC rail voting. */
+static int
+gpu_rpmh_measured_init(const struct gpu_power_experiment *x)
+{
+	static const struct { unsigned char region; uint32_t off, wrote, got; } known[] = {
+		{ 0, 0x23034, 0, 0x82204514 }, { 0, 0x2303c, 0, 0x82204510 },
+		{ 0, 0x23044, 0, 0x82204520 },
+		{ 1, 0x55d4, 0x10108, 0x10100 }, { 1, 0x55e4, 0x10108, 0x10100 },
+		{ 1, 0x55f4, 0x10108, 0x10100 }, { 1, 0x5764, 0x10108, 0x10100 },
+		{ 1, 0x5774, 0x10108, 0x10100 }, { 1, 0x5784, 0x10108, 0x10100 },
+	};
+	if (!x->init_requested || !x->init_done_writes || x->init_nwrites != GPU_RPMH_INIT_COUNT ||
+	    !x->init_stop_done || x->init_bad != 9 || x->init_nbad_log != 9) return 0;
+	for (unsigned int i = 0; i < 9; i++) {
+		if (x->init_bad_region[i] != known[i].region || x->init_bad_off[i] != known[i].off ||
+		    x->init_bad_wrote[i] != known[i].wrote || x->init_bad_got[i] != known[i].got) return 0;
+	}
+	return 1;
+}
