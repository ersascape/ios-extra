+/* Step 4a: TCM retention + a6xx_rpmh_start/stop, no firmware execution. */
+static void
+gpu_rsc_wake_run(vm_offset_t gmu, vm_offset_t cc, struct gpu_power_experiment *x)
+{
+	struct gpu_rsc_wake *w = &x->wake;
+	static const uint32_t expected[6] = { 0, 0, 1, 1, 0x01010006, 1 };
+	w->requested = 1;
+	if (x->preboot_error || x->preboot_done != GPU_PREBOOT_READS ||
+	    !x->buf.inactive || x->buf.error || x->buf.passed != GPU_BUF_CHECKS) {
+		w->error = "pre-boot/buffer gate incomplete; nothing written";
+		return;
+	}
+	if (!gpu_rpmh_measured_init(x)) {
+		w->error = "RSC init readbacks differ from 0092-0094; nothing written";
+		return;
+	}
+	gpu_rsc_wake_snapshot(gmu, w->before);
+	w->snapshots |= 1;
+	for (unsigned int i = 0; i < 6; i++) {
+		if (w->before[i] != expected[i]) {
+			w->error = "live RSC/retention/reset state differs from 0094; nothing written";
+			return;
+		}
+	}
+	if (gpu_read32(gmu, 0x14068) != 0) {
+		w->error = "CM3 not idle; nothing written";
+		return;
+	}
+	w->gx[0] = gpu_read32(cc, GPU_GX_GDSCR);
+	if (w->gx[0] == ~0u || (w->gx[0] & GPU_DOMAIN_ON) || !(w->gx[0] & GPU_GDSC_SW_COLLAPSE)) {
+		w->error = "GX not in measured collapsed state; nothing written";
+		return;
+	}
+	gpu_write32(gmu, 0x14730, 1); /* mainline TCM retention, before wake */
+	w->retention_on = gpu_read32(gmu, 0x14730);
+	if (w->retention_on != 1) {
+		w->error = "TCM retention write did not read back";
+		goto restore_retention;
+	}
+	printf("SWEET GPU: RSC wake requesting bit 1; CM3 stays reset\n");
+	gpu_write32(gmu, 0x24c1c, 2);
+	w->started = 1;
+	for (unsigned int i = 0; i < GPU_WAKE_POLLS; i++) {
+		w->ack = gpu_read32(gmu, 0x24c20);
+		w->ack_polls = i + 1;
+		if (w->ack != ~0u && (w->ack & 2u)) { w->ack_done = 1; break; }
+		delay(100);
+	}
+	if (!w->ack_done) {
+		w->error = "RSC wake ACK bit 1 timed out";
+	} else {
+		for (unsigned int i = 0; i < GPU_WAKE_POLLS; i++) {
+			w->busy = gpu_read32(gmu, 0x23404);
+			w->busy_polls = i + 1;
+			if (w->busy == 0) { w->busy_done = 1; break; }
+			delay(100);
+		}
+		if (!w->busy_done) w->error = "RSC wake SEQ_BUSY timed out";
+	}
+	gpu_rsc_wake_snapshot(gmu, w->awake);
+	w->gx[1] = gpu_read32(cc, GPU_GX_GDSCR);
+	if (w->gx[1] != w->gx[0]) w->error = "GX state changed during RSC wake";
+	w->snapshots |= 2;
+	/* Drop wake even on error, then use the already measured stop request. */
+	gpu_write32(gmu, 0x24c1c, 0);
+	gpu_write32(gmu, 0x24c1c, 1);
+	w->stop_attempted = 1;
+	for (unsigned int i = 0; i < GPU_WAKE_POLLS; i++) {
+		w->status = gpu_read32(gmu, 0x23010);
+		w->stop_polls = i + 1;
+		if (w->status != ~0u && (w->status & (1u << 16))) { w->stop_done = 1; break; }
+		delay(100);
+	}
+	gpu_write32(gmu, 0x24c1c, 0);
+	if (!w->stop_done) w->error = "RSC stop after wake timed out";
+restore_retention:
+	gpu_write32(gmu, 0x14730, w->before[0]);
+	w->retention_off = gpu_read32(gmu, 0x14730);
+	gpu_rsc_wake_snapshot(gmu, w->final);
+	w->gx[2] = gpu_read32(cc, GPU_GX_GDSCR);
+	w->snapshots |= 4;
+	w->controls_restored = w->retention_off == w->before[0] && w->final[1] == 0 && w->final[5] == 1 && w->gx[2] == w->gx[0];
+	w->state_restored = 1;
+	for (unsigned int i = 0; i < 6; i++) {
+		if (w->final[i] != w->before[i]) w->state_restored = 0;
+	}
+	if (!w->controls_restored) w->error = "retention/REQ/reset/GX controls not restored";
+}
