+/*
+ * Votes an ARC rail's hardware level by table INDEX (cmd-db auxiliary table
+ * holds raw corner values, e.g. 64 = LOW_SVS). corner 0 releases the vote
+ * (index 0, requires table[0] == 0); otherwise the first table entry >= corner
+ * is requested. Table must be non-decreasing up to its zero padding. ACTIVE
+ * set only: RPMh aggregates with other masters, so this cannot lower a rail.
+ */
+int
+sweet_rpmh_arc_set(const char *res, unsigned corner, unsigned *level)
+{
+	if (!res || (strcmp(res, "cx.lvl") && strcmp(res, "mx.lvl")) || corner > 128) {
+		printf("SWEET RPMH: expected cx.lvl/mx.lvl and corner 0..128\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, aux = 0, vote = 0;
+	unsigned len = 0, count = 0, index = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_ARC, &address, &aux, &len);
+	}
+	if (error) {
+		goto out;
+	}
+	count = len / 2;
+	error = EINVAL;
+	if (rh_db16(aux) != 0) {
+		printf("SWEET RPMH: %s table[0] is not 0\n", res);
+		goto out;
+	}
+	for (unsigned i = 1; i < count; ++i) {
+		uint16_t v = rh_db16(aux + 2 * i), prev = rh_db16(aux + 2 * (i - 1));
+		if (!v) { /* zero padding ends the table */
+			count = i;
+			break;
+		}
+		if (v <= prev) {
+			printf("SWEET RPMH: %s table is not increasing\n", res);
+			goto out;
+		}
+	}
+	if (corner) {
+		for (index = 1; index < count && rh_db16(aux + 2 * index) < corner; ++index) {
+		}
+		if (index >= count) {
+			printf("SWEET RPMH: %s has no level >= %u\n", res, corner);
+			goto out;
+		}
+	}
+	vote = index;
+	printf("SWEET RPMH: %s corner %u -> hlvl index %u (raw %u of %u levels)\n",
+	    res, corner, index, rh_db16(aux + 2 * index), count);
+	error = rh_send(address & ~15u, 1, &address, &vote);
+	if (!error && level) {
+		*level = index;
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC set failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
