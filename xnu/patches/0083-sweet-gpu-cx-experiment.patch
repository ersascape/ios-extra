@@ -10,16 +10,23 @@
  * sweetgpu=2 also snapshots firmware command DB ARC metadata/level tables.
  * It maps only the known locator and its validated reserved-RAM database;
  * no RPMh RSC/TCS access or rail votes are needed for that inspection.
+ * sweetgpu=3 adds one bounded, fully rolled back CX power experiment: vote
+ * mx.lvl and cx.lvl to LOW_SVS through the apps-DRV RPMh client, clear the CX
+ * GDSC SW_COLLAPSE bit, wait for PWR_ON, then collapse it again and release
+ * both votes. No clocks, GMU, GX, SMMU or firmware are touched. The outcome
+ * is cached with the boot report so USB replays show it.
  * Register provenance and limitations: ios-extra/docs/GPU_BRINGUP.md.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <pexpert/pexpert.h>
+#include <kern/clock.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 void sweet_gpu_probe(void);
 void sweet_gpu_replay(void);
+int sweet_rpmh_arc_set(const char *res, unsigned corner, unsigned *level);
 
 #define GPU_GCC_PA              0x00100000
 #define GPU_GCC_SIZE            0x00090000
@@ -31,6 +38,12 @@ void sweet_gpu_replay(void);
 #define GPU_BRANCH_ENABLE       (1u << 0)
 #define GPU_BRANCH_OFF          (1u << 31)
 #define GPU_DOMAIN_ON           (1u << 31)
+#define GPU_GDSC_SW_COLLAPSE    (1u << 0)
+#define GPU_GDSC_HW_CONTROL     (1u << 1)
+#define GPU_CX_IDLE_GDSCR       0x00222001u /* value observed after ABL */
+#define GPU_LOW_SVS             64u
+#define GPU_GDSC_POLL_US        1000u
+#define GPU_GDSC_HOLD_US        1000u
 
 #define GPU_DB_LOCATOR_PA       0x0c3f000cu
 #define GPU_DB_HEADER           144u
@@ -59,6 +72,17 @@ struct gpu_arc_inventory {
 	struct gpu_arc_resource resource[GPU_ARC_RESOURCES];
 };
 
+/* Cached outcome of the sweetgpu=3 CX experiment (0 = step not reached). */
+struct gpu_power_experiment {
+	unsigned int requested;
+	const char *error;
+	int mx_vote, cx_vote, mx_release, cx_release;
+	unsigned int mx_level, cx_level;
+	uint32_t before, after_enable, after_hold, after_disable;
+	unsigned int enable_polls, disable_polls;
+	int enabled, disabled;
+};
+
 struct sweet_gpu_clock {
 	const char *name;
 	uint32_t off;
@@ -100,6 +124,7 @@ struct gpu_inventory {
 	uint32_t cx, gx;
 	enum gpu_inventory_state state;
 	struct gpu_arc_inventory arc;
+	struct gpu_power_experiment power;
 };
 
 /* Published once by the UFS startup path, read by the USB log thread. */
@@ -135,6 +160,96 @@ gpu_db_read16(vm_offset_t db, uint32_t off)
 	return value;
 }
 
+static void
+gpu_write32(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* Polls GDSCR PWR_ON until it equals want; returns polls used or 0 on timeout. */
+static unsigned int
+gpu_gdsc_wait(vm_offset_t cc, int want, uint32_t *value)
+{
+	for (unsigned int i = 1; i <= GPU_GDSC_POLL_US; i++) {
+		*value = gpu_read32(cc, GPU_CX_GDSCR);
+		if (*value != ~0u && !!(*value & GPU_DOMAIN_ON) == want) {
+			return i;
+		}
+		delay(1);
+	}
+	*value = gpu_read32(cc, GPU_CX_GDSCR);
+	return 0;
+}
+
+/*
+ * Mirrors the downstream gdsc_enable/disable order for the CX domain, which
+ * has no clocks, resets or clamps of its own in the DT: parent rail first
+ * (MX, then CX at LOW_SVS), then SW_COLLAPSE, then PWR_ON. Every exit path
+ * collapses the domain again and releases the votes in reverse order.
+ */
+static void
+gpu_power_experiment(vm_offset_t cc, struct gpu_power_experiment *x)
+{
+	uint32_t v;
+
+	x->requested = 1;
+	x->before = gpu_read32(cc, GPU_CX_GDSCR);
+	if (x->before != GPU_CX_IDLE_GDSCR) {
+		x->error = "CX GDSCR is not the expected collapsed state; nothing touched";
+		return;
+	}
+	x->mx_vote = sweet_rpmh_arc_set("mx.lvl", GPU_LOW_SVS, &x->mx_level);
+	if (x->mx_vote) {
+		x->error = "mx.lvl vote failed; nothing else touched";
+		return;
+	}
+	x->cx_vote = sweet_rpmh_arc_set("cx.lvl", GPU_LOW_SVS, &x->cx_level);
+	if (x->cx_vote) {
+		x->error = "cx.lvl vote failed";
+		goto release_mx;
+	}
+	v = gpu_read32(cc, GPU_CX_GDSCR);
+	gpu_write32(cc, GPU_CX_GDSCR, v & ~GPU_GDSC_SW_COLLAPSE);
+	delay(1); /* 8 XO cycles before polling, as downstream */
+	x->enable_polls = gpu_gdsc_wait(cc, 1, &x->after_enable);
+	x->enabled = x->enable_polls != 0;
+	if (x->enabled) {
+		delay(GPU_GDSC_HOLD_US);
+		x->after_hold = gpu_read32(cc, GPU_CX_GDSCR);
+	} else {
+		x->error = "CX PWR_ON did not assert";
+	}
+	v = gpu_read32(cc, GPU_CX_GDSCR);
+	gpu_write32(cc, GPU_CX_GDSCR, v | GPU_GDSC_SW_COLLAPSE);
+	delay(1);
+	x->disable_polls = gpu_gdsc_wait(cc, 0, &x->after_disable);
+	x->disabled = x->disable_polls != 0;
+	if (!x->disabled && !x->error) {
+		x->error = "CX PWR_ON did not clear after collapse";
+	}
+	x->cx_release = sweet_rpmh_arc_set("cx.lvl", 0, NULL);
+release_mx:
+	x->mx_release = sweet_rpmh_arc_set("mx.lvl", 0, NULL);
+}
+
+static void
+gpu_power_log(const struct gpu_power_experiment *x)
+{
+	if (!x->requested) {
+		return;
+	}
+	printf("SWEET GPU: CX experiment before=0x%08x\n", x->before);
+	printf("SWEET GPU: CX experiment votes mx=%d(hlvl %u) cx=%d(hlvl %u) release cx=%d mx=%d\n",
+	    x->mx_vote, x->mx_level, x->cx_vote, x->cx_level, x->cx_release, x->mx_release);
+	printf("SWEET GPU: CX experiment enable=%d polls=%u GDSCR=0x%08x hold=0x%08x\n",
+	    x->enabled, x->enable_polls, x->after_enable, x->after_hold);
+	printf("SWEET GPU: CX experiment collapse=%d polls=%u GDSCR=0x%08x\n",
+	    x->disabled, x->disable_polls, x->after_disable);
+	printf("SWEET GPU: CX experiment result: %s\n", x->error ? x->error : "complete, rolled back");
+}
+
 static void
 gpu_arc_collect(struct gpu_arc_inventory *arc)
 {
@@ -309,9 +424,11 @@ gpu_inventory_log(const struct gpu_inventory *inventory, unsigned int replay)
 	for (unsigned int i = 0; i < GPU_CC_CLOCK_COUNT; i++) {
 		gpu_clock_log("GPUCC", &gpu_cc_clocks[i], inventory->cc[i]);
 	}
-	printf("SWEET GPU: GPU/GMU/SMMU skipped (no power hold); no hardware writes\n");
+	printf("SWEET GPU: GPU/GMU/SMMU skipped (no power hold)%s\n",
+	    inventory->power.requested ? "" : "; no hardware writes");
 done:
 	gpu_arc_log(&inventory->arc);
+	gpu_power_log(&inventory->power);
 	printf("SWEET GPU: END boot inventory report %u\n", replay);
 }
 
@@ -326,11 +443,11 @@ sweet_gpu_probe(void)
 	if (!PE_parse_boot_argn("sweetgpu", &mode, sizeof(mode)) || mode == 0) {
 		return;
 	}
-	if (mode != 1 && mode != 2) {
-		printf("SWEET GPU: unsupported sweetgpu=%d (0=off, 1=clocks, 2=clocks+ARC)\n", mode);
+	if (mode < 1 || mode > 3) {
+		printf("SWEET GPU: unsupported sweetgpu=%d (0=off, 1=clocks, 2=+ARC, 3=+CX experiment)\n", mode);
 		return;
 	}
-	if (mode == 2) {
+	if (mode >= 2) {
 		gpu_arc_collect(&inventory.arc);
 	}
 	gcc = ml_io_map(GPU_GCC_PA, GPU_GCC_SIZE);
@@ -356,6 +473,15 @@ sweet_gpu_probe(void)
 		inventory.cc[i] = gpu_read32(cc, gpu_cc_clocks[i].off);
 	}
 	inventory.state = GPU_COMPLETE;
+	/* Only after the read-only inventory above, and only if the ARC tables parsed. */
+	if (mode == 3) {
+		if (inventory.arc.error) {
+			inventory.power.requested = 1;
+			inventory.power.error = "ARC inventory failed; experiment not attempted";
+		} else {
+			gpu_power_experiment(cc, &inventory.power);
+		}
+	}
 publish:
 	gpu_boot_inventory = inventory;
 	gpu_inventory_log(&gpu_boot_inventory, 0);
