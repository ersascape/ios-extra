+/* HFI queue indices are shared CPU/GMU state. Use Normal noncached CPU
+ * mappings so CPU cache-line writeback cannot overwrite GMU-owned indices. */
+static int
+fp6_gmu_hfi_set_wcomb(struct fp6_gmu_domain *d, uint32_t address)
+{
+	ppnum_t pages[8];
+	uint64_t first_pa = 0;
+	unsigned count = 0;
+	if (!d || d->frozen || d->failed || address != fp6_gmu_hfi_va)
+		return -1;
+	struct fp6_gmu_domain_range *range = NULL;
+	for (unsigned i = 0; i < d->count; i++)
+		if (d->ranges[i].complete && d->ranges[i].address == address)
+			range = &d->ranges[i];
+	if (!range || !range->backing.va || !range->mapped_size ||
+	    ((uintptr_t)range->backing.va & PAGE_MASK))
+		return -1;
+	vm_size_t bytes = (range->mapped_size + PAGE_MASK) & ~PAGE_MASK;
+	if (!bytes || bytes / PAGE_SIZE > sizeof(pages) / sizeof(pages[0]))
+		return -1;
+	for (vm_size_t offset = 0; offset < bytes; offset += PAGE_SIZE) {
+		ppnum_t ppn = pmap_find_phys(kernel_pmap,
+		    (addr64_t)(uintptr_t)range->backing.va + offset);
+		if (!ppn) return -1;
+		uint64_t pa = ptoa_64(ppn);
+		if (offset == 0) first_pa = pa;
+		else if (pa != first_pa + offset) return -1;
+		unsigned int attr = pmap_cache_attributes(ppn) & VM_WIMG_MASK;
+		if (attr != VM_WIMG_DEFAULT && attr != VM_WIMG_WCOMB) return -1;
+		pages[count++] = ppn;
+	}
+	for (unsigned i = 0; i < count; i++)
+		if ((pmap_cache_attributes(pages[i]) & VM_WIMG_MASK) != VM_WIMG_WCOMB)
+			pmap_set_cache_attributes(pages[i], VM_WIMG_WCOMB);
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (unsigned i = 0; i < count; i++) {
+		if ((pmap_cache_attributes(pages[i]) & VM_WIMG_MASK) != VM_WIMG_WCOMB) {
+			printf("QCOM GMU: HFI CPU cache attribute verify failed page=%u ppn=0x%llx\n",
+			    i, (unsigned long long)pages[i]);
+			return -1;
+		}
+	}
+	printf("QCOM GMU: HFI CPU backing WCOMB pages=%u size=0x%x PA=0x%llx\n",
+	    count, range->mapped_size, (unsigned long long)first_pa);
+	return 0;
+}
