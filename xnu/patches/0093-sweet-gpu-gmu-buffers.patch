+		    b->pa, GPU_BUF_BYTES, b->stage, b->checks, GPU_BUF_CHECKS, b->passed, b->inactive, b->restored);
+		printf("SWEET GPU: buffers IOVA dummy/debug/log/HFI=0x60000000/0x60001000/0x60005000/0x60009000 sizes=4096/16384/16384/16384 HFI-size=120\n");
+		for (unsigned int i = 0; i < b->checks; i++) {
