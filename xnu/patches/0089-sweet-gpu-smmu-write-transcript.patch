+/* Write, read back at once, and keep both values for the report. */
+static uint64_t
+gpu_smmu_set(vm_offset_t smmu, struct gpu_power_experiment *x, uint32_t off, uint64_t value, int wide)
+{
+	uint64_t got;
+
+	if (wide) {
+		gpu_write64(smmu, off, value);
+		got = gpu_read64(smmu, off);
+	} else {
+		gpu_write32(smmu, off, (uint32_t)value);
+		got = gpu_read32(smmu, off);
+	}
+	if (x->ctx_nlog < GPU_SMMU_LOG) {
+		x->ctx_log_off[x->ctx_nlog] = off;
+		x->ctx_log_wrote[x->ctx_nlog] = value;
+		x->ctx_log_got[x->ctx_nlog] = got;
+		x->ctx_log_wide[x->ctx_nlog] = wide != 0;
+		x->ctx_nlog++;
+	}
+	return got;
+}
