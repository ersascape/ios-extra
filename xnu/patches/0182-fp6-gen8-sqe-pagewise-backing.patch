+static int
+fp6_gpu_exec_alloc_sqe(void)
+{
+	if (!FP6_EXEC_SQE_PAGES || fp6_gpu_global_domain.count + FP6_EXEC_SQE_PAGES + 2u > FP6_GPU_GLOBAL_MAPS) {
+		printf("QCOM GPU EXEC: SQE page count exceeds permanent global-map capacity pages=%u\n",
+		    FP6_EXEC_SQE_PAGES);
+		return 0;
+	}
+	for (unsigned i = 0; i < FP6_EXEC_SQE_PAGES; i++) {
+		uint32_t mapped = 0;
+		uint64_t va = 0;
+		if (fp6_gpu_global_va(&fp6_gpu_global_domain, 4096u, 12u, &va, &mapped) || mapped != 4096u) {
+			printf("QCOM GPU EXEC: SQE VA reservation failed page=%u/%u\n", i, FP6_EXEC_SQE_PAGES);
+			return 0;
+		}
+		if (i == 0) fp6_exec_sqe_va = va;
+		else if (va != fp6_exec_sqe_va + (uint64_t)i * 4096u) {
+			printf("QCOM GPU EXEC: SQE GPU VA is not contiguous page=%u va=0x%llx\n",
+			    i, (unsigned long long)va);
+			return 0;
+		}
