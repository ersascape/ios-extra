+			return 0;
+		}
+		uint32_t offset = i * 4096u;
+		uint32_t bytes = FP6_SQE_FW_SIZE - offset;
+		if (bytes > 4096u) bytes = 4096u;
+		memcpy(fp6_exec_sqe[i].va, fp6_sqe_fw + offset, bytes);
+		(void)fp6_gpu_kernel_publish(NULL, fp6_exec_sqe[i].va, 4096u);
+		if (!fp6_gpu_global_map_live(fp6_gpu_smmu_base, va, 4096u,
+		    fp6_exec_sqe[i].pa, FP6_HFI_MEMFLAG_GFX_PRIV)) {
+			printf("QCOM GPU EXEC: SQE SMMU page map failed page=%u VA=0x%llx PA=0x%llx\n",
+			    i, (unsigned long long)va, (unsigned long long)fp6_exec_sqe[i].pa);
+			return 0;
+		}
+	}
 	return 1;
 }
 
