+/* Where is the CP when a replay stalls? Per-pipe IB1/IB2 base, remaining and initial
+ * size plus ROQ occupancy (dword register numbers times four, via the CP aperture). */
+static void
+fp6_gpu_cp_ib_dump(vm_offset_t gpu)
+{
+	for (uint32_t pipe = 1u; pipe <= 2u; pipe++) {
+		fp6_smmu_write32(gpu, FP6_GPU_CP_APERTURE_CNTL_HOST, pipe << 12);
+		printf("QCOM GPU REPLAY: pipe=%u IB1=0x%08x%08x rem=%u init=%u IB2=0x%08x%08x rem=%u init=%u ROQ rb=%u ib1=%u ib2=%u\n",
+		    pipe,
+		    fp6_smmu_read32(gpu, 0x2404u), fp6_smmu_read32(gpu, 0x2400u),
+		    fp6_smmu_read32(gpu, 0x2408u), fp6_smmu_read32(gpu, 0x240cu),
+		    fp6_smmu_read32(gpu, 0x2414u), fp6_smmu_read32(gpu, 0x2410u),
+		    fp6_smmu_read32(gpu, 0x2418u), fp6_smmu_read32(gpu, 0x241cu),
+		    fp6_smmu_read32(gpu, 0x2460u), fp6_smmu_read32(gpu, 0x2464u),
+		    fp6_smmu_read32(gpu, 0x2468u));
+	}
+	fp6_smmu_write32(gpu, FP6_GPU_CP_APERTURE_CNTL_HOST, 0u);
+}
+
 #define FP6_REPLAY_FENCE_OFFSET 0x100u /* dword index in the result page */
 #define FP6_REPLAY_FENCE_VALUE 0x600dcafeu
 
@@ -5008,14 +5027,16 @@
 	    fp6_smmu_read32(fp6_gpu_smmu_base, fp6_gpu_cb_off + FP6_SMMU_CB_FSR));
 	if (seen != FP6_REPLAY_FENCE_VALUE || good != total) {
 		fp6_gpu_exec_snapshot(g, gpu, "after-replay");
+		fp6_gpu_cp_ib_dump(gpu);
 		return 0;
 	}
 	fp6_replay_done[index] = 1;
 	return 1;
 }
 
