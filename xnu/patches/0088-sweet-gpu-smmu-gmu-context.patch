+/* AArch64 long-descriptor bits (4 KiB granule), stage 1. */
+#define GPU_PTE_TABLE   3ull
+#define GPU_PTE_PAGE    (3ull | (1ull << 10) | (3ull << 8) | (1ull << 6) | (1ull << 11) | (1ull << 54))
+
+static int
+gpu_smmu_tlb_flush(vm_offset_t smmu, uint32_t cb)
+{
+	gpu_write32(smmu, cb + GPU_SMMU_CB_TLBIALL, 0);
+	gpu_write32(smmu, cb + GPU_SMMU_CB_TLBSYNC, 0);
+	for (unsigned int i = 0; i < GPU_CLK_POLL_US; i++) {
+		if (!(gpu_read32(smmu, cb + GPU_SMMU_CB_TLBSTATUS) & 1u)) {
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+/* Hardware address translate (privileged read). Returns 0 with *par set when it finished. */
+static int
+gpu_smmu_atos(vm_offset_t smmu, uint32_t cb, uint32_t va, uint64_t *par)
+{
+	gpu_write64(smmu, cb + GPU_SMMU_CB_ATS1PR, va);
+	delay(1);
+	for (unsigned int i = 0; i < GPU_CLK_POLL_US; i++) {
+		if (!(gpu_read32(smmu, cb + GPU_SMMU_CB_ATSR) & 1u)) {
+			*par = gpu_read64(smmu, cb + GPU_SMMU_CB_PAR);
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static void
+gpu_smmu_gmu_context(vm_offset_t smmu, struct gpu_power_experiment *x)
+{
+	const uint32_t cb = GPU_SMMU_CB0 + GPU_SMMU_GMU_CB * 0x1000u;
+	const uint32_t n = GPU_SMMU_GMU_CB;
+	static const uint32_t va[GPU_SMMU_VERIFY] = { 0x60000000u, 0x60000fffu, 0x60001000u, 0x20000000u };
+	static const uint32_t fault[GPU_SMMU_VERIFY] = { 0, 0, 1, 1 };
+	vm_offset_t kva = 0;
+	uint64_t pa, ttbr;
+	volatile uint64_t *tbl;
+	int wrote = 0, flush_failed = 0;
+
+	x->ctx_requested = 1;
+	if (x->smmu_nsmr <= n || x->smmu_ncb <= n || x->smmu_gr0[0] == ~0u || (x->smmu_gr0[0] & 1u)) {
+		x->ctx_error = "SMMU geometry/state unsuitable; nothing programmed";
+		return;
+	}
+	/* Everything we touch must still be exactly as ABL left it. */
+	if (gpu_read32(smmu, GPU_SMMU_SMR + 4 * n) != 0 ||
+	    gpu_read32(smmu, GPU_SMMU_S2CR + 4 * n) != GPU_SMMU_S2CR_FAULT ||
+	    gpu_read32(smmu, GPU_SMMU_CBAR + 4 * n) != 0 ||
+	    gpu_read32(smmu, GPU_SMMU_CBA2R + 4 * n) != 0 ||
+	    gpu_read32(smmu, cb + GPU_SMMU_CB_SCTLR) != 0 ||
+	    gpu_read64(smmu, cb + GPU_SMMU_CB_TTBR0) != 0 ||
+	    gpu_read32(smmu, cb + GPU_SMMU_CB_TCR) != 0) {
+		x->ctx_error = "target stream group / context bank is not in the ABL default state; nothing programmed";
+		return;
+	}
+	if (kmem_alloc_contig(kernel_map, &kva, GPU_SMMU_TBL_BYTES, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS || !kva) {
+		x->ctx_error = "no contiguous page for the tables; nothing programmed";
+		return;
+	}
+	pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)kva));
+	if (!pa || (pa & 0xfffu) || pa >= (1ull << 36)) {
+		x->ctx_error = "page-table memory outside the SMMU's 36-bit output range";
+		return;
+	}
+	x->ctx_pa = pa;
+	/* L1 @0 (4 entries used), L2 @0x1000, L3 @0x2000, data page @0x3000. */
+	tbl = (volatile uint64_t *)kva;
+	tbl[1] = (pa + 0x1000) | GPU_PTE_TABLE;                    /* L1[1]: 0x40000000.. */
+	((volatile uint64_t *)(kva + 0x1000))[256] = (pa + 0x2000) | GPU_PTE_TABLE; /* 0x60000000.. */
+	x->ctx_pte3 = (pa + 0x3000) | GPU_PTE_PAGE;                /* attr index 0 = normal NC */
+	((volatile uint64_t *)(kva + 0x2000))[0] = x->ctx_pte3;
+	clean_dcache64((addr64_t)pa, 0x3000, TRUE);
+	ttbr = pa;
+	x->ctx_ttbr = ttbr;
+	x->ctx_stage = 1;
+	wrote = 1;
+	/* Context bank first, stream match last (a stream matches only once it is complete). */
+	gpu_write32(smmu, GPU_SMMU_CBA2R + 4 * n, 1u);                       /* VA64 */
+	gpu_write32(smmu, GPU_SMMU_CBAR + 4 * n, 1u << 16);                  /* S1 translate, S2 bypass */
+	gpu_write32(smmu, cb + GPU_SMMU_CB_TCR2, 1u);                        /* PASIZE 36 bit */
+	gpu_write32(smmu, cb + GPU_SMMU_CB_TCR, 32u | (2u << 12) | (1u << 23)); /* T0SZ 32, SH0 outer, EPD1 */
+	gpu_write64(smmu, cb + GPU_SMMU_CB_TTBR0, ttbr);
+	gpu_write32(smmu, cb + GPU_SMMU_CB_MAIR0, 0x44u);                    /* attr0 normal non-cacheable */
+	gpu_write32(smmu, cb + GPU_SMMU_CB_MAIR1, 0);
+	if (gpu_smmu_tlb_flush(smmu, cb)) {
+		flush_failed = 1;
+	}
+	gpu_write32(smmu, cb + GPU_SMMU_CB_SCTLR, 0x27u);                    /* M | TRE | AFE | CFRE */
+	x->ctx_stage = 2;
+	gpu_write32(smmu, GPU_SMMU_S2CR + 4 * n, n);                         /* translate via CB n */
+	gpu_write32(smmu, GPU_SMMU_SMR + 4 * n, (1u << 31) | GPU_SMMU_GMU_SID);
+	x->ctx_stage = 3;
+	if (flush_failed) {
+		x->ctx_error = "TLB invalidate did not complete";
+	}
+	for (unsigned int i = 0; i < GPU_SMMU_VERIFY && !x->ctx_error; i++) {
+		x->ctx_va[i] = va[i];
+		x->ctx_expect_fault[i] = fault[i];
+		x->ctx_stage = 4 + i;
+		if (gpu_smmu_atos(smmu, cb, va[i], &x->ctx_par[i])) {
+			x->ctx_error = "ATOS did not complete";
+			break;
+		}
+		if (fault[i] ? (x->ctx_par[i] & 1u) :
+		    (!(x->ctx_par[i] & 1u) && (x->ctx_par[i] & 0x0000fffffffff000ull) == ((pa + 0x3000) & ~0xfffull))) {
+			x->ctx_passed++;
+		} else {
+			x->ctx_error = "ATOS result differs from the expected mapping";
+		}
+	}
+	x->ctx_fsr = gpu_read32(smmu, cb + 0x58);
+	x->ctx_gfsr = gpu_read32(smmu, 0x48);
+	/* Restore, stream match first. */
+	gpu_write32(smmu, GPU_SMMU_SMR + 4 * n, 0);
+	gpu_write32(smmu, GPU_SMMU_S2CR + 4 * n, GPU_SMMU_S2CR_FAULT);
+	gpu_write32(smmu, cb + GPU_SMMU_CB_SCTLR, 0);
+	gpu_write64(smmu, cb + GPU_SMMU_CB_TTBR0, 0);
+	gpu_write32(smmu, cb + GPU_SMMU_CB_TCR, 0);
+	gpu_write32(smmu, cb + GPU_SMMU_CB_TCR2, 0);
+	gpu_write32(smmu, cb + GPU_SMMU_CB_MAIR0, 0);
+	gpu_write32(smmu, cb + GPU_SMMU_CB_MAIR1, 0);
+	gpu_write32(smmu, GPU_SMMU_CBAR + 4 * n, 0);
+	gpu_write32(smmu, GPU_SMMU_CBA2R + 4 * n, 0);
+	(void)gpu_smmu_tlb_flush(smmu, cb);
+	x->ctx_final[0] = gpu_read32(smmu, GPU_SMMU_SMR + 4 * n);
+	x->ctx_final[1] = gpu_read32(smmu, GPU_SMMU_S2CR + 4 * n);
+	x->ctx_final[2] = gpu_read32(smmu, cb + GPU_SMMU_CB_SCTLR);
+	x->ctx_final[3] = gpu_read32(smmu, GPU_SMMU_CBAR + 4 * n);
+	x->ctx_restored = wrote && x->ctx_final[0] == 0 && x->ctx_final[1] == GPU_SMMU_S2CR_FAULT &&
+	    x->ctx_final[2] == 0 && x->ctx_final[3] == 0;
 }
 
