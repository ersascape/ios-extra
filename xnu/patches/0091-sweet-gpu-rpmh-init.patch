+/* One write of mainline's A618 a6xx_gmu_rpmh_init. region 0 = GMU block (RSCC base
+ * 0x23000 applied by the table), 1 = gmu_pdc, 2 = gmu_pdc_seq. off is a byte offset. */
+static const struct { unsigned char region; uint32_t off; uint32_t value; } gpu_rpmh_init[] = {
+	{ 0, GPU_RSCC_BASE + 0x0004 * 4, 1u << 24 },          /* disable SDE clock gating */
+	{ 0, GPU_RSCC_BASE + 0x000b * 4, 1 },                 /* PDC_SLAVE_ID_DRV0 */
+	{ 0, GPU_RSCC_BASE + 0x000e * 4, 0 },                 /* HIDDEN_TCS_CMD0_DATA */
+	{ 0, GPU_RSCC_BASE + 0x000d * 4, 0 },                 /* HIDDEN_TCS_CMD0_ADDR */
+	{ 0, GPU_RSCC_BASE + 0x0010 * 4, 0 },
+	{ 0, GPU_RSCC_BASE + 0x000f * 4, 0 },
+	{ 0, GPU_RSCC_BASE + 0x0012 * 4, 0x80000000u },
+	{ 0, GPU_RSCC_BASE + 0x0011 * 4, 0 },
+	{ 0, GPU_RSCC_BASE + 0x0100 * 4, 0 },                 /* OVERRIDE_START_ADDR */
+	{ 0, GPU_RSCC_BASE + 0x0008 * 4, 0x4520 },            /* PDC_SEQ_START_ADDR */
+	{ 0, GPU_RSCC_BASE + 0x0009 * 4, 0x4510 },            /* PDC_MATCH_VALUE_LO */
+	{ 0, GPU_RSCC_BASE + 0x000a * 4, 0x4514 },            /* PDC_MATCH_VALUE_HI */
+	{ 0, GPU_RSCC_BASE + 0x0180 * 4, 0xa7a506a0u },       /* RSC sequencer uCode */
+	{ 0, GPU_RSCC_BASE + 0x0181 * 4, 0xa1e6a6e7u },
+	{ 0, GPU_RSCC_BASE + 0x0182 * 4, 0xa2e081e1u },
+	{ 0, GPU_RSCC_BASE + 0x0183 * 4, 0xe9a982e2u },
+	{ 0, GPU_RSCC_BASE + 0x0184 * 4, 0x0020e8a8u },
+	{ 2, 0 * 4, 0xfebea1e1u },                            /* PDC sequencer uCode */
+	{ 2, 1 * 4, 0xa5a4a3a2u },
+	{ 2, 2 * 4, 0x8382a6e0u },
+	{ 2, 3 * 4, 0xbce3e284u },
+	{ 2, 4 * 4, 0x002081fcu },
+	{ 1, 0x1573 * 4, 7 }, { 1, 0x1574 * 4, 0 }, { 1, 0x1572 * 4, 0 },   /* TCS1 (sleep) */
+	{ 1, 0x1575 * 4, 0x10108 }, { 1, 0x1576 * 4, 0x30010 }, { 1, 0x1577 * 4, 1 },
+	{ 1, 0x1579 * 4, 0x10108 }, { 1, 0x157a * 4, 0x30000 }, { 1, 0x157b * 4, 0 },
+	{ 1, 0x157d * 4, 0x10108 }, { 1, 0x157e * 4, 0x30090 }, { 1, 0x157f * 4, 0 },
+	{ 1, 0x15d7 * 4, 7 }, { 1, 0x15d8 * 4, 0 }, { 1, 0x15d6 * 4, 0 },   /* TCS3 (wake), A618 data */
+	{ 1, 0x15d9 * 4, 0x10108 }, { 1, 0x15da * 4, 0x30010 }, { 1, 0x15db * 4, 2 },
+	{ 1, 0x15dd * 4, 0x10108 }, { 1, 0x15de * 4, 0x30000 }, { 1, 0x15df * 4, 2 },
+	{ 1, 0x15e1 * 4, 0x10108 }, { 1, 0x15e2 * 4, 0x30090 }, { 1, 0x15e3 * 4, 3 },
+	{ 1, 0x1148 * 4, 0 },                                 /* GPU_SEQ_START_ADDR */
+	{ 1, 0x1140 * 4, 0x80000001u },                       /* GPU_ENABLE_PDC */
+};
+#define GPU_RPMH_INIT_COUNT (sizeof(gpu_rpmh_init) / sizeof(gpu_rpmh_init[0]))
+
+static void
+gpu_rpmh_init_run(vm_offset_t gmu, struct gpu_power_experiment *x)
+{
+	vm_offset_t base[3] = { gmu, 0, 0 };
+
+	x->init_requested = 1;
+	/* Only on the state measured by 0090: PDC disabled, sequencer memories empty, idle RSC. */
+	if (!x->pdc_mapped || !x->seq_mapped || x->rsc_done < GPU_RSC_READS || x->pdc_done < GPU_PDC_READS ||
+	    x->seq_done < GPU_PDC_SEQ_READS) {
+		x->init_error = "RSC/PDC inventory incomplete; nothing written";
+		return;
+	}
+	if (x->pdc_value[0] != 0 || x->seq_value[0] != 0 || x->rsc_value[9] != 0 ||
+	    x->rsc_value[12] != 0 || x->rsc_value[8] != 0) {
+		x->init_error = "RSC/PDC not in the expected unprogrammed state; nothing written";
+		return;
+	}
+	base[1] = x->pdc_base;
+	base[2] = x->seq_base;
+	for (unsigned int i = 0; i < GPU_RPMH_INIT_COUNT; i++) {
+		uint32_t got;
+		gpu_write32(base[gpu_rpmh_init[i].region], gpu_rpmh_init[i].off, gpu_rpmh_init[i].value);
+		x->init_nwrites = i + 1;
+		got = gpu_read32(base[gpu_rpmh_init[i].region], gpu_rpmh_init[i].off);
+		if (got != gpu_rpmh_init[i].value) {
+			if (!x->init_bad) {
+				x->init_first_bad_region = gpu_rpmh_init[i].region;
+				x->init_first_bad_off = gpu_rpmh_init[i].off;
+				x->init_first_bad_wrote = gpu_rpmh_init[i].value;
+				x->init_first_bad_got = got;
+			}
+			x->init_bad++;
+		}
+	}
+	x->init_done_writes = 1;
+	/* a6xx_rpmh_stop: request the RSC power-off handshake, wait for the status bit. */
+	gpu_write32(gmu, 0x9307 * 4, 1);
+	for (unsigned int i = 0; i < GPU_RPMH_STOP_POLL_US; i++) {
+		x->init_stop_status = gpu_read32(gmu, GPU_RSCC_BASE + 0x0004 * 4);
+		if (x->init_stop_status != ~0u && (x->init_stop_status & (1u << 16))) {
+			x->init_stop_done = 1;
+			break;
+		}
+		delay(1);
+	}
+	gpu_write32(gmu, 0x9307 * 4, 0);
+	if (!x->init_stop_done) {
+		x->init_error = "RSC stop handshake did not complete";
+	} else if (x->init_bad) {
+		x->init_error = "some writes did not read back";
+	}
+}
