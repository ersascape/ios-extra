--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -3163,13 +3163,17 @@
  * This requests GX power and waits for the GMU's completion before any GPU
  * core MMIO read. Keep the SMMU context and votes retained on timeout. */
 static int
-fp6_gmu_gpu_oob(vm_offset_t g, uint32_t *intr_info)
+fp6_gmu_gpu_oob(vm_offset_t g, uint32_t *intr_info, uint32_t *raw_before,
+		uint32_t *raw_after)
 {
+	*raw_before = fp6_smmu_read32(g, 0x47658u); /* HOST2GMU_INTR_RAW_INFO */
 	fp6_smmu_write32(g, 0x47650u, 1u << 30);
+	*raw_after = fp6_smmu_read32(g, 0x47658u);
 	uint32_t v = 0;
 	int ack = fp6_gmu_poll(g, 0x47648u, 1u << 31, 1u << 31, &v);
 	*intr_info = v;
 	if (ack) fp6_smmu_write32(g, 0x47644u, 1u << 31);
+	else *raw_after = fp6_smmu_read32(g, 0x47658u);
 	return ack;
 }
 
@@ -4320,18 +4324,23 @@
 		if (hfi) {
 			uint8_t *hfi_mem = fp6_gmu_range_va(fp6_gmu_hfi_va);
 			if (!hfi_mem || !fp6_gmu_hfi_start_sequence(smmu, cb_off, g,
-			    fp6_smmu_read32(g, 0x3dfecu), hfi_mem)) {
+			    fp6_smmu_read32(g, 0x3dff0u), hfi_mem)) {
 				printf("QCOM GMU: HFI startup sequence stopped; GMU will be reset\n");
 			} else {
 				vm_offset_t gpu = ml_io_map(0x03d00000u, 0x40000u);
-				uint32_t info = 0;
+				uint32_t info = 0, raw_before = 0, raw_after = 0;
 				if (!gpu) {
 					printf("QCOM GMU: GPU OOB probe refused: core MMIO map unavailable\n");
-				} else if (!fp6_gmu_gpu_oob(g, &info)) {
-					printf("QCOM GMU: GPU OOB timeout intr_info=0x%08x; CM3 reset will be asserted\n", info);
+				} else if (!fp6_gmu_gpu_oob(g, &info, &raw_before, &raw_after)) {
+					printf("QCOM GMU: GPU OOB timeout raw_before=0x%08x raw_after=0x%08x intr_info=0x%08x gfx_pwr_clk=0x%08x rpmh=0x%08x fw_init=0x%08x fw_busy=0x%08x CB0_FSR=0x%08x sGFSR=0x%08x; CM3 reset will be asserted\n",
+					    raw_before, raw_after, info, fp6_smmu_read32(g, 0x46fa0u),
+					    fp6_smmu_read32(g, 0x46fa4u), fp6_smmu_read32(g, 0x47070u),
+					    fp6_smmu_read32(g, 0x47068u),
+					    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_FSR),
+					    fp6_smmu_read32(smmu, 0x048u));
 				} else {
 					uint32_t rbbm = fp6_smmu_read32(gpu, 0x048u); /* GEN8_RBBM_STATUS */
-					printf("QCOM GMU: GPU OOB ACK intr_info=0x%08x RBBM_STATUS=0x%08x; status read only\n", info, rbbm);
+					printf("QCOM GMU: GPU OOB ACK raw_before=0x%08x raw_after=0x%08x intr_info=0x%08x RBBM_STATUS=0x%08x; status read only\n", raw_before, raw_after, info, rbbm);
 					fp6_smmu_write32(g, 0x47650u, 1u << 31); /* Linux oob_clear(oob_gpu) */
 					printf("QCOM GMU: GPU OOB clear requested; no GPU command submitted\n");
 				}
