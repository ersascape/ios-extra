+static uint16_t
+fp6_cmd_db_u16(vm_offset_t db, unsigned off)
+{
+	uint32_t word = fp6_smmu_read32(db, off & ~3u);
+	return (uint16_t)(word >> ((off & 2u) * 8u));
+}
+
+/* cmd_db_read_aux_data() returns a little-endian u16 array for ARC resources. */
+static int
+fp6_cmd_db_arc(vm_offset_t db, uint32_t name0, uint32_t name1,
+	    uint16_t *values, unsigned *count)
+{
+	if (fp6_smmu_read32(db, 4) != 0x0c0330dbu) return 0;
+	for (unsigned h = 8; h < 136; h += 16) {
+		uint32_t a = fp6_smmu_read32(db, h);
+		unsigned slave_id = a & 0xffffu;
+		if (!slave_id) break;
+		if (slave_id != 3u) continue;
+		uint32_t b = fp6_smmu_read32(db, h + 4);
+		unsigned entries = 144u + (a >> 16);
+		unsigned aux = 144u + (b & 0xffffu);
+		unsigned nentries = b >> 16;
+		if (entries > 0x20000u || nentries > (0x20000u - entries) / 24u || aux > 0x20000u)
+			return 0;
+		for (unsigned n = 0; n < nentries; n++) {
+			unsigned e = entries + n * 24u;
+			if (fp6_smmu_read32(db, e) != name0 || fp6_smmu_read32(db, e + 4) != name1)
+				continue;
+			uint32_t tail = fp6_smmu_read32(db, e + 20);
+			unsigned len = tail & 0xffffu;
+			unsigned off = aux + (tail >> 16);
+			if (len < 2 || (len & 1u) || off > 0x20000u || len > 0x20000u - off)
+				return 0;
+			unsigned max = len / 2u;
+			if (max > 16u) return 0;
+			for (unsigned i = 0; i < max; i++) values[i] = fp6_cmd_db_u16(db, off + 2u * i);
+			unsigned used = 1;
+			for (; used < max; used++)
+				if (values[used - 1] != 0 && values[used] == 0) break;
+			*count = used;
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int
+fp6_arc_vote(const uint16_t *primary, unsigned nprimary,
+	    const uint16_t *secondary, unsigned nsecondary, uint16_t level, uint32_t *vote)
+{
+	unsigned p, s;
+	uint16_t selected;
+	if (!nprimary || !nsecondary) return 0;
+	for (p = 0; p < nprimary; p++) if (primary[p] >= level) break;
+	if (p == nprimary) return 0;
+	selected = primary[p];
+	for (s = 0; s < nsecondary; s++)
+		if (secondary[s] >= selected || s + 1u == nsecondary) break;
+	if (s == nsecondary) s = 0;
+	*vote = ((uint32_t)selected << 16) | (s << 8) | p;
+	return 1;
+}
+
+static uint32_t
+fp6_hfi_hdr(unsigned id, unsigned dwords)
+{
+	return (id & 0xffu) | ((dwords & 0xffu) << 8);
+}
+
+static uint32_t
+fp6_hfi_bw_word(uint32_t level_kbps, unsigned bcm_width, unsigned buswidth,
+	    uint32_t unit, int commit)
+{
+	uint64_t vote;
+	if (!level_kbps) return commit ? 0x40000000u : 0u;
+	if (!buswidth || !unit) return 0xffffffffu;
+	vote = (uint64_t)level_kbps * bcm_width / buswidth;
+	vote = vote * 1000u / unit;
+	if (!vote) vote = 1;
+	if (vote > 0x3fffu) vote = 0x3fffu;
+	/* BCM_TCS_CMD(commit, valid, average-X, peak-Y), with AB=IB. */
+	return (commit ? 0x40000000u : 0u) | 0x20000000u |
+	    ((uint32_t)vote << 14) | (uint32_t)vote;
+}
