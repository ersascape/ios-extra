+static int
+fp6_gmu_hfi_start_sequence(vm_offset_t g, uint8_t *mem)
+{
+	static const uint32_t ddr_levels[] = { 0, 0x000bebc2u, 0x00209a8eu };
+	static const uint32_t cnoc_levels[] = { 0, 0x64u };
+	static const uint32_t gpu_freq_khz = 362000u; /* stock FP6 selected pwrlevel */
+	static const uint32_t gmu_freq_khz[] = { 0, 350000u, 650000u };
+	static const uint16_t gpu_vlvl = 0x40u;
+	static const uint16_t gmu_vlvl[] = { 0, 0x40u, 0x80u };
+	uint16_t gfx[16] = {0}, cx[16] = {0}, mx[16] = {0};
+	unsigned ngfx = 0, ncx = 0, nmx = 0, seq = 0;
+	struct fp6_bcm_meta bcm[4];
+	vm_offset_t db = ml_io_map(0x81c60000u, 0x20000u);
+	uint32_t gx_vote, cx_vote[3];
+	uint32_t perf[20] = {0};
+	uint32_t bw[160] = {0};
+	unsigned perf_dw = 19;
+	if (!db || !fp6_cmd_db_arc(db, 0x2e786667u, 0x006c766cu, gfx, &ngfx) ||
+	    !fp6_cmd_db_arc(db, 0x6c2e7863u, 0x00006c76u, cx, &ncx) ||
+	    !fp6_cmd_db_arc(db, 0x6c2e786du, 0x00006c76u, mx, &nmx) ||
+	    gfx[0] != 0 || cx[0] != 0 || mx[0] != 0 ||
+	    !fp6_arc_vote(gfx, ngfx, mx, nmx, gpu_vlvl, &gx_vote) ||
+	    !fp6_arc_vote(cx, ncx, mx, nmx, gmu_vlvl[0], &cx_vote[0]) ||
+	    !fp6_arc_vote(cx, ncx, mx, nmx, gmu_vlvl[1], &cx_vote[1]) ||
+	    !fp6_arc_vote(cx, ncx, mx, nmx, gmu_vlvl[2], &cx_vote[2])) {
+		printf("QCOM GMU: HFI pre-start refused ARC data gfx/cx/mx=%u/%u/%u\n", ngfx, ncx, nmx);
+		return 0;
+	}
+	static const uint32_t names[4] = {
+		0x00304853u, 0x0030434du, 0x00564341u, 0x304e43u
+	};
+	for (unsigned i = 0; i < 4; i++) {
+		if (!fp6_cmd_db_bcm(db, names[i], &bcm[i]) || !bcm[i].addr ||
+		    bcm[i].addr == 0xffffffffu) {
+			printf("QCOM GMU: HFI pre-start refused BCM metadata index=%u\n", i);
+			return 0;
+		}
+	}
+	/* H2F_MSG_TABLE / HFI_TABLE_GPU_PERF: selected 362 MHz GPU row plus GMU 350/650 MHz. */
+	perf[0] = fp6_hfi_hdr(15u, perf_dw);
+	perf[1] = 0;
+	perf[2] = 1;
+	perf[3] = 2; perf[4] = 3;
+	perf[5] = 0; perf[6] = 0xffffffffu; perf[7] = 0;
+	perf[8] = gx_vote; perf[9] = 0xffffffffu; perf[10] = gpu_freq_khz;
+	perf[11] = 3; perf[12] = 2;
+	perf[13] = 0; perf[14] = 0;
+	perf[15] = cx_vote[1]; perf[16] = gmu_freq_khz[1];
+	perf[17] = cx_vote[2]; perf[18] = gmu_freq_khz[2];
+	if (!fp6_gmu_hfi_send_req(g, mem, perf, perf_dw, &seq)) return 0;
+	printf("QCOM GMU: HFI GPU perf table ACK gfx=%uMHz ARC=0x%08x GMU=%u/%uMHz\n",
+	    gpu_freq_khz / 1000u, gx_vote, gmu_freq_khz[1] / 1000u, gmu_freq_khz[2] / 1000u);
+	/* H2F_MSG_BW_VOTE_TBL. First three DDR levels are identical for DDR7/DDR8. */
+	bw[0] = fp6_hfi_hdr(3u, 160u);
+	bw[1] = 3; bw[2] = 1; bw[3] = 3;
+	bw[4] = 1;
+	for (unsigned j = 0; j < 3; j++)
+		if (j == 2 || bcm[j].vcd != bcm[j + 1].vcd) bw[5] |= 1u << j;
+	bw[6] = bcm[3].addr; /* CN0 command address */
+	bw[12] = bcm[3].addr;
+	for (unsigned i = 0; i < 2; i++) {
+		bw[12u + i * 6u] = fp6_hfi_bw_word(cnoc_levels[i], bcm[3].width, 4u,
+		    bcm[3].unit, 1);
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		for (unsigned j = 0; j < 3; j++) {
+			unsigned idx = 24u + j;
+			bw[idx] = bcm[j].addr;
+			int commit = j == 2 || bcm[j].vcd != bcm[j + 1].vcd;
+			uint32_t data;
+			if (j == 2) {
+				/* ACV perfmode threshold is original DDR index 9, not this subset. */
+				data = i == 0 ? 0x40000000u : 0x60000000u;
+			} else {
+				unsigned buswidth = j == 0 ? 16u : 4u;
+				data = fp6_hfi_bw_word(ddr_levels[i], bcm[j].width, buswidth,
+				    bcm[j].unit, commit);
+			}
+			bw[32u + i * 8u + j] = data;
+		}
+	}
+	if (!fp6_gmu_hfi_send_req(g, mem, bw, 160u, &seq)) return 0;
+	printf("QCOM GMU: HFI DDR/CNOC table ACK levels=%u/%u BCM=%08x/%08x/%08x/%08x\n",
+	    3u, 2u, bcm[0].addr, bcm[1].addr, bcm[2].addr, bcm[3].addr);
+	uint32_t feature[4] = { fp6_hfi_hdr(11u, 4u), 1u, 1u, 0u };
+	if (!fp6_gmu_hfi_send_req(g, mem, feature, 4u, &seq)) return 0;
+	feature[0] = fp6_hfi_hdr(11u, 4u); feature[1] = 16u;
+	if (!fp6_gmu_hfi_send_req(g, mem, feature, 4u, &seq)) return 0;
+	uint32_t start[2] = { fp6_hfi_hdr(14u, 2u), 0u };
+	return fp6_gmu_hfi_send_req(g, mem, start, 2u, &seq);
 }
 
