+/* Configure Linux's GPU-reserved CB0 as the split TTBR1 global aperture.
+ * SID0 is blocked until all context state and translations are verified. */
+static int
+fp6_gpu_global_context_enable(vm_offset_t smmu)
+{
+	uint32_t id0, id1, id2, scr0;
+	unsigned groups, banks, page_shift, numpages, group = FP6_SMMU_MAX_STREAMS;
+	uint64_t cb_base;
+	uint32_t cb_off;
+	if (fp6_gpu_smmu_live)
+		return smmu == fp6_gpu_smmu_base;
+	if (!smmu || fp6_gpu_global_domain.failed || !fp6_gpu_global_domain.l0.va)
+		return 0;
+	id0 = fp6_smmu_read32(smmu, FP6_SMMU_IDR0);
+	id1 = fp6_smmu_read32(smmu, FP6_SMMU_IDR1);
+	id2 = fp6_smmu_read32(smmu, FP6_SMMU_IDR2);
+	scr0 = fp6_smmu_read32(smmu, FP6_SMMU_SCR0);
+	groups = id0 & FP6_SMMU_ID0_NUMSMRG;
+	banks = id1 & 0xffu;
+	page_shift = (id1 & FP6_SMMU_ID1_PAGESIZE) ? 16u : 12u;
+	numpages = 1u << (((id1 >> 28) & 7u) + 1u);
+	cb_base = (uint64_t)numpages << page_shift;
+	if (!(id0 & FP6_SMMU_ID0_SMS) || !groups || groups > FP6_SMMU_MAX_STREAMS ||
+	    banks < 3u || banks > FP6_SMMU_MAX_CBS || page_shift != 12u ||
+	    !(id2 & FP6_SMMU_ID2_PTFS_4K) || ((id2 >> 4) & 0xfu) != 1u ||
+	    scr0 == 0xffffffffu || (scr0 & 1u) || cb_base >= FP6_GPU_SMMU_SIZE) {
+		printf("QCOM GPU SMMU: SID0 setup refused unsupported geometry/global state\n");
+		return 0;
+	}
+	for (unsigned i = 0; i < groups; i++) {
+		uint32_t smr = fp6_smmu_read32(smmu, FP6_SMMU_SMR(i));
+		uint32_t s2cr = fp6_smmu_read32(smmu, FP6_SMMU_S2CR(i));
+		unsigned sid = smr & 0xffffu, mask = (smr >> 16) & 0x7fffu;
+		if ((smr & FP6_SMMU_SMR_VALID) && (((sid ^ 0u) & ~mask & 0xffffu) == 0)) {
+			printf("QCOM GPU SMMU: SID0 already matched group=%u; refusing takeover\n", i);
+			return 0;
+		}
+		if (!(smr & FP6_SMMU_SMR_VALID) &&
+		    (s2cr & FP6_SMMU_S2CR_TYPE_MASK) == FP6_SMMU_S2CR_FAULT &&
+		    group == FP6_SMMU_MAX_STREAMS)
+			group = i;
+	}
+	cb_off = (uint32_t)cb_base; /* CB0: reserved by Linux for GPU global TTBR1. */
+	if (group == FP6_SMMU_MAX_STREAMS ||
+	    fp6_smmu_read32(smmu, FP6_SMMU_CBAR(0)) ||
+	    fp6_smmu_read32(smmu, FP6_SMMU_CBA2R(0)) ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_SCTLR) ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_TCR) ||
+	    fp6_smmu_read64(smmu, cb_off + FP6_SMMU_CB_TTBR0) ||
+	    fp6_smmu_read64(smmu, cb_off + FP6_SMMU_CB_TTBR1) ||
+	    (fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_TCR2) & ~0x60u) ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_MAIR0) ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_MAIR1) ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_FSR)) {
+		printf("QCOM GPU SMMU: CB0 or fault-routed SID0 group is not clean\n");
+		return 0;
+	}
+	/* Linux TTBR1: T1SZ=16, SH1=Outer, TG1=4K, EPD0=1, A1=0. */
+	fp6_smmu_write32(smmu, FP6_SMMU_CBA2R(0), 1u);
+	fp6_smmu_write32(smmu, FP6_SMMU_CBAR(0), 0x0001f300u);
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_TCR2, 0x00038011u);
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_TCR, 0xa0100080u);
+	fp6_smmu_write64(smmu, cb_off + FP6_SMMU_CB_TTBR0, 0);
+	fp6_smmu_write64(smmu, cb_off + FP6_SMMU_CB_TTBR1, fp6_gpu_global_domain.l0.pa);
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_MAIR0, 0xf404ff44u);
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_MAIR1, 0x0000efe4u);
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_TLBIALL, FP6_SMMU_DUMMY_VAL);
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_TLBSYNC, FP6_SMMU_DUMMY_VAL);
+	for (unsigned i = 0; i < 1000u; i++) {
+		if (!(fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_TLBSTATUS) & 1u)) goto tlb_ready;
+		delay(10);
+	}
+	printf("QCOM GPU SMMU: CB0 TLBI sync timed out; route remains blocked\n");
+	return 0;
+tlb_ready:
+	if (fp6_smmu_read32(smmu, FP6_SMMU_CBA2R(0)) != 1u ||
+	    fp6_smmu_read32(smmu, FP6_SMMU_CBAR(0)) != 0x0001f300u ||
+	    (fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_TCR2) & ~0x60u) != 0x00038011u ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_TCR) != 0xa0100080u ||
+	    fp6_smmu_read64(smmu, cb_off + FP6_SMMU_CB_TTBR1) != fp6_gpu_global_domain.l0.pa ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_MAIR0) != 0xf404ff44u ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_MAIR1) != 0x0000efe4u) {
+		printf("QCOM GPU SMMU: CB0 TTBR1 setup readback failed; route remains blocked\n");
+		return 0;
+	}
+	/* Match Linux's default non-halting GPU fault policy plus S1_ASIDPNE. */
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_SCTLR, 0x1167u);
+	fp6_smmu_write32(smmu, FP6_SMMU_S2CR(group), 0u); /* translate through CB0 */
+	fp6_smmu_write32(smmu, FP6_SMMU_SMR(group), FP6_SMMU_SMR_VALID);
+	if ((fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_SCTLR) & ~0x1000u) != 0x0167u ||
+	    fp6_smmu_read32(smmu, FP6_SMMU_S2CR(group)) != 0u ||
+	    fp6_smmu_read32(smmu, FP6_SMMU_SMR(group)) != FP6_SMMU_SMR_VALID) {
+		fp6_smmu_write32(smmu, FP6_SMMU_SMR(group), 0u);
+		if (fp6_smmu_read32(smmu, FP6_SMMU_SMR(group)) == 0u) {
+			fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_SCTLR, 0u);
+			(void)fp6_smmu_read32(smmu, FP6_SMMU_IDR0);
+		}
+		printf("QCOM GPU SMMU: SID0 route readback failed; mapping storage retained\n");
+		return 0;
+	}
+	fp6_gpu_smmu_base = smmu;
+	fp6_gpu_cb_off = cb_off;
+	fp6_gpu_smr_group = group;
+	fp6_gpu_smmu_live = 1;
+	printf("QCOM GPU SMMU: SID0 -> CB0 TTBR1 active group=%u root=0x%llx TCR=0xa0100080 SCTLR=0x%08x\n",
+	    group, (unsigned long long)fp6_gpu_global_domain.l0.pa,
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_SCTLR));
+	return 1;
+}
+
+static int
+fp6_gpu_global_map_live(vm_offset_t smmu, uint64_t address, uint32_t size,
+		uint64_t pa, uint32_t flags)
+{
+	int live = fp6_gpu_smmu_live;
+	if (!smmu || (live && (smmu != fp6_gpu_smmu_base ||
+	    (fp6_smmu_read32(smmu, fp6_gpu_cb_off + FP6_SMMU_CB_SCTLR) & ~0x1000u) != 0x0167u)) ||
+	    fp6_gpu_global_domain.failed ||
+	    fp6_gpu_global_map(&fp6_gpu_global_domain, address, size, pa, flags) ||
+	    fp6_gpu_global_publish(&fp6_gpu_global_domain)) {
+		printf("QCOM GPU SMMU: global mapping publish failed VA=0x%llx bytes=%u\n",
+		    (unsigned long long)address, size);
+		return 0;
+	}
+	if (fp6_gpu_global_walk(&fp6_gpu_global_domain, address) != pa) return 0;
+	if (!live) return fp6_gpu_global_context_enable(smmu);
+	fp6_smmu_write32(smmu, fp6_gpu_cb_off + FP6_SMMU_CB_TLBIALL, FP6_SMMU_DUMMY_VAL);
+	fp6_smmu_write32(smmu, fp6_gpu_cb_off + FP6_SMMU_CB_TLBSYNC, FP6_SMMU_DUMMY_VAL);
+	for (unsigned i = 0; i < 1000u; i++) {
+		if (!(fp6_smmu_read32(smmu, fp6_gpu_cb_off + FP6_SMMU_CB_TLBSTATUS) & 1u)) {
+			__asm__ volatile("dsb sy" ::: "memory");
+			return fp6_gpu_global_walk(&fp6_gpu_global_domain, address) == pa;
+		}
+		delay(10);
+	}
+	printf("QCOM GPU SMMU: CB0 TLB sync timed out; mappings retained\n");
+	return 0;
+}
+
+static int
+fp6_gmu_domain_map_external_live(vm_offset_t smmu, uint32_t cb_off,
+		uint32_t address, uint32_t size, int cached, uint32_t flags,
+		const struct fp6_gpu_global_page *gpu_backing)
+{
+	struct fp6_gmu_domain_page backing;
+	if (!gpu_backing || !smmu || !fp6_gmu_domain.frozen || fp6_gmu_domain.failed ||
+	    fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_SCTLR) != 0x27u) {
+		printf("QCOM GMU: shared HFI backing map refused: context not live\n");
+		return 0;
+	}
+	backing.va = (uint8_t *)(uintptr_t)gpu_backing->va;
+	backing.pa = gpu_backing->pa;
+	fp6_gmu_domain.frozen = 0;
+	int mapped = fp6_gmu_domain_reserve_external_access(&fp6_gmu_domain, address,
+	    size, cached, (flags & FP6_HFI_MEMFLAG_GMU_WRITEABLE) != 0,
+	    (flags & FP6_HFI_MEMFLAG_GMU_PRIV) != 0, &backing);
+	if (!mapped) mapped = fp6_gmu_domain_publish(&fp6_gmu_domain);
+	fp6_gmu_domain.frozen = 1;
+	if (mapped) return 0;
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_TLBIALL, FP6_SMMU_DUMMY_VAL);
+	fp6_smmu_write32(smmu, cb_off + FP6_SMMU_CB_TLBSYNC, FP6_SMMU_DUMMY_VAL);
+	for (unsigned i = 0; i < 1000u; i++) {
+		if (!(fp6_smmu_read32(smmu, cb_off + FP6_SMMU_CB_TLBSTATUS) & 1u)) {
+			__asm__ volatile("dsb sy" ::: "memory");
+			return 1;
+		}
+		delay(10);
+	}
+	printf("QCOM GMU: shared HFI backing TLB sync timed out; CM3 reset required\n");
+	return 0;
+}
