+static int
+fp6_gpu_kernel_publish(void *ctx, const void *va, uint32_t size)
+{
+	(void)ctx;
+	clean_dcache64((addr64_t)(uintptr_t)va, size, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
