+static int
+fp6_gpu_kernel_alloc(void *ctx, uint32_t size, struct fp6_gpu_global_page *page)
+{
+	(void)ctx;
+	vm_offset_t va = 0;
+	vm_size_t bytes = (size + PAGE_MASK) & ~PAGE_MASK;
+	if (!size || kmem_alloc_contig(kernel_map, &va, bytes, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS || !va)
+		return -1;
+	ppnum_t ppn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	page->va = (uint8_t *)(uintptr_t)va;
+	page->pa = ptoa_64(ppn);
+	return !ppn || page->pa >= (1ULL << 36) || bytes > (1ULL << 36) - page->pa ? -1 : 0;
+}
