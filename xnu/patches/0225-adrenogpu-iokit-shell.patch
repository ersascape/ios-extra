+/* ---- entry point for the bring-up code; nothing calls it yet ---- */
+
+static AdrenoGPU *adrenogpu_instance;
+
+extern "C" int
+adrenogpu_iokit_start(const struct adrenogpu_hw_ops *hw, const struct adrenogpu_hw_info *info)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("adrenogpu", &enabled, sizeof(enabled)) || enabled != 1) {
+		return ADRENOGPU_IOKIT_DISABLED;
+	}
+	if (hw == NULL || info == NULL) {
+		return ADRENOGPU_IOKIT_EFAIL;
+	}
+	IOService *resources = IOService::getResourceService();
+	if (resources == NULL) {
+		return ADRENOGPU_IOKIT_EFAIL;
+	}
+	AdrenoGPU *gpu = OSTypeAlloc(AdrenoGPU);
+	if (gpu == NULL) {
+		return ADRENOGPU_IOKIT_EFAIL;
+	}
+	if (!gpu->setup(hw, info)) {
+		gpu->release();
+		return ADRENOGPU_IOKIT_EFAIL;
+	}
+	AdrenoGPU *expected = NULL;
+	if (!__atomic_compare_exchange_n(&adrenogpu_instance, &expected, gpu, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		gpu->release();
+		return ADRENOGPU_IOKIT_EEXIST;
+	}
+	if (!gpu->attach(resources)) {
+		__atomic_store_n(&adrenogpu_instance, (AdrenoGPU *)NULL, __ATOMIC_RELEASE);
+		gpu->release();
+		return ADRENOGPU_IOKIT_EFAIL;
+	}
+	if (!gpu->start(resources)) {
+		gpu->detach(resources);
+		__atomic_store_n(&adrenogpu_instance, (AdrenoGPU *)NULL, __ATOMIC_RELEASE);
+		gpu->release();
+		return ADRENOGPU_IOKIT_EFAIL;
+	}
+	return ADRENOGPU_IOKIT_STARTED; /* adrenogpu_instance keeps the reference */
+}
