 static int
+fp6_gmu_hfi_ack_status_result(const uint32_t *ack, unsigned size, uint32_t *result)
+{
+	if (!ack || !result) return 0;
+	if (size == 3u) {
+		*result = 0;
+		return ack[2] == 0;
+	}
+	if (size == 4u) {
+		*result = ack[2];
+		return ack[3] == 0; /* GMU_SUCCESS in the v5 inline-ACK format */
+	}
+	return 0;
+}
