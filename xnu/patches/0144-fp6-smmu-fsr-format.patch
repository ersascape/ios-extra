+	 * (0b10 = AArch64 context from CBA2R.VA64); FP6 reads 0x400 here. */
+	if (fsr_after_clear & 0xc00001feu) {
 		failure = "fault clear"; fail_off = cb_off + FP6_SMMU_CB_FSR;
 		fail_got = fsr_after_clear;
 		goto rollback;
