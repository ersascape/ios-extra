--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -3352,7 +3352,10 @@
 	FP6_SMMU_WRITE_CHECK(cb_off + FP6_SMMU_CB_MAIR1, 0u);
 	fp6_smmu_write32(base, cb_off + FP6_SMMU_CB_FSR, 0xffffffffu); /* W1C stale faults */
 	uint32_t fsr_after_clear = fp6_smmu_read32(base, cb_off + FP6_SMMU_CB_FSR);
-	if (fsr_after_clear != 0) {
+	/* Only arm-smmu.h ARM_SMMU_FSR_FAULT bits (MULTI, SS, UUT, ASF, TLBLKF,
