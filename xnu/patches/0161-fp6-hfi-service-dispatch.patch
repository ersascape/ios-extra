 static int
+fp6_gmu_hfi_enqueue(vm_offset_t g, uint8_t *mem, uint32_t *msg,
+	    unsigned dwords, unsigned *sequence)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(void *)mem;
+	volatile uint32_t *cmd_hdr = t + 6;
+	volatile uint32_t *cmdq;
+	unsigned rounded = (dwords + 3u) & ~3u;
+	if (!dwords || dwords > 240u || rounded >= 1024u ||
+	    cmd_hdr[0] != 1u || cmd_hdr[3] != 1024u ||
+	    cmd_hdr[10] >= 1024u || cmd_hdr[11] >= 1024u ||
+	    (cmd_hdr[10] & 3u) || (cmd_hdr[11] & 3u) ||
+	    cmd_hdr[1] != fp6_gmu_hfi_va + FP6_GMU_HFI_QUEUE0 ||
+	    cmd_hdr[10] != cmd_hdr[11])
+		return 0;
+	cmdq = (volatile uint32_t *)(void *)(mem + FP6_GMU_HFI_QUEUE0);
+	unsigned seq = (*sequence + 1u) & 0xfffu;
+	if (!seq) seq = 1u;
+	*sequence = seq;
+	msg[0] = (msg[0] & 0x000f00ffu) | (seq << 20) | (dwords << 8);
+	unsigned wi = cmd_hdr[11];
+	for (unsigned j = 0; j < dwords; j++) cmdq[(wi + j) % 1024u] = msg[j];
+	for (unsigned j = dwords; j < rounded; j++) cmdq[(wi + j) % 1024u] = 0xfafafafau;
+	cmd_hdr[11] = (wi + rounded) % 1024u;
+	flush_dcache64((addr64_t)(uintptr_t)mem, FP6_GMU_HFI_SIZE, FALSE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	fp6_smmu_write32(g, 0x47650u, 1u); /* HOST2GMU_INTR_SET: MSGQ */
+	return 1;
+}
