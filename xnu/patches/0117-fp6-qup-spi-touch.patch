--- /dev/null
+++ b/bsd/dev/qcom_geni.h
@@ -0,0 +1,59 @@
+/*
+ * Qualcomm QUPv3 GENI serial engine (SE) core: polled FIFO mode only.
+ *
+ * One struct qgeni_se per engine. The board supplies the SE and GCC
+ * physical addresses and the engine's GCC clock description; this core
+ * maps them, brings the clocks up (vote + XO source), checks the firmware
+ * loaded by the boot chain, and runs FIFO transfers. No DMA, no GSI, no
+ * interrupts: callers poll from their own thread.
+ *
+ * Register offsets and sequences follow Linux drivers/soc/qcom/qcom-geni-se.c
+ * and drivers/spi/spi-geni-qcom.c.
+ */
+#ifndef _BSD_DEV_QCOM_GENI_H_
+#define _BSD_DEV_QCOM_GENI_H_
+
+#include <sys/types.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+
+#define QGENI_PROTO_SPI         1u
+#define QGENI_PROTO_UART        2u
+#define QGENI_PROTO_I2C         3u
+
+/* GCC clocks of one serial engine. */
+struct qgeni_clk {
+	uint32_t        vote_reg;       /* branch vote register (APCS) */
+	uint32_t        vote_mask;      /* wrapper core/2x/AHB + SE bits */
+	uint32_t        rcg;            /* SE RCG CMD register (CFG at +4) */
+	uint32_t        halts[6];       /* branch status registers, 0 ends */
+};
+
+struct qgeni_se {
+	const char             *name;
+	uint64_t                se_pa, gcc_pa;
+	uint32_t                gcc_size;
+	const struct qgeni_clk *clk;
+	vm_offset_t             base, gcc;
+	unsigned                proto;
+	unsigned                tx_depth, rx_depth;     /* FIFO words */
+	bool                    dead;
+	uint32_t                irq_seen;               /* diagnostics */
+};
+
+int qgeni_map(struct qgeni_se *se);
+/* Read only: true when every branch of the SE reports its clock running. */
+bool qgeni_clocks_running(struct qgeni_se *se);
+/* Read only: GCC and (only with clocks running) SE state to the console. */
+void qgeni_dump(struct qgeni_se *se);
+/* Vote the branches, set the RCG to XO (19.2 MHz) and wait for them. */
+int qgeni_clocks_on(struct qgeni_se *se);
+/* Check firmware protocol and FIFO availability, then FIFO-mode setup. */
+int qgeni_fifo_init(struct qgeni_se *se, unsigned proto);
+/* SPI mode 0..3, chip select, clock (from 19.2 MHz), CS-to-clock delay. */
+int qgeni_spi_setup(struct qgeni_se *se, unsigned mode, unsigned cs,
+    unsigned hz, unsigned cs_clk_delay);
+/* One full-duplex transfer with CS held throughout. rx may be NULL. */
+int qgeni_spi_xfer(struct qgeni_se *se, const uint8_t *tx, uint8_t *rx, unsigned len);
+
+#endif /* _BSD_DEV_QCOM_GENI_H_ */
