@@ -248,6 +405,21 @@ gpu_power_log(const struct gpu_power_experiment *x)
 	printf("SWEET GPU: CX experiment collapse=%d polls=%u GDSCR=0x%08x\n",
 	    x->disabled, x->disable_polls, x->after_disable);
 	printf("SWEET GPU: CX experiment result: %s\n", x->error ? x->error : "complete, rolled back");
+	if (!x->clk_requested) {
+		return;
+	}
+	printf("SWEET GPU: GMU clk GPLL0 mode=0x%08x vote=0x%08x gate(0x52004) before=0x%08x on=0x%08x\n",
+	    x->gpll0_mode, x->gpll0_vote, x->gate_before, x->gate_on);
+	printf("SWEET GPU: GMU clk RCG +0x1120/+0x1124 before=0x%08x/0x%08x after-update=0x%08x/0x%08x\n",
+	    x->rcg_cmd0, x->rcg_cfg0, x->rcg_cmd1, x->rcg_cfg1);
+	printf("SWEET GPU: GMU clk CBCR ahb/cx-gmu/cxo before=0x%08x/0x%08x/0x%08x\n",
+	    x->cbcr_before[0], x->cbcr_before[1], x->cbcr_before[2]);
+	printf("SWEET GPU: GMU clk CBCR ahb/cx-gmu/cxo on    =0x%08x/0x%08x/0x%08x\n",
+	    x->cbcr_on[0], x->cbcr_on[1], x->cbcr_on[2]);
+	printf("SWEET GPU: GMU clk CBCR ahb/cx-gmu/cxo off   =0x%08x/0x%08x/0x%08x\n",
+	    x->cbcr_after[0], x->cbcr_after[1], x->cbcr_after[2]);
+	printf("SWEET GPU: GMU clk stage=%u restored=%u result: %s\n", x->clk_stage,
+	    x->clk_restored, x->clk_error ? x->clk_error : "complete, rolled back");
 }
 
