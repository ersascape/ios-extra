+/* fp6gpucompute=N (1..16) runs every kernel once and repeats kernel 0 N times in a
+ * row; it stops at the first failure so a fault cannot be mixed with later runs. */
+static int
+fp6_gpu_compute_probe(vm_offset_t g, vm_offset_t gpu)
+{
+	int wanted = 0;
+	if (!PE_parse_boot_argn("fp6gpucompute", &wanted, sizeof(wanted)) || wanted < 1 || wanted > 16) {
+		printf("QCOM GPU COMPUTE: skipped; fp6gpucompute=1..16 not requested\n");
+		return 1;
+	}
+	if (!fp6_exec_pages_ready) {
+		printf("QCOM GPU COMPUTE: refused; execution pages unavailable\n");
+		return 0;
+	}
+	unsigned passed = 0;
+	for (unsigned t = 0; t < FP6_CS_TEST_COUNT; t++) {
+		unsigned runs = t == 0 ? (unsigned)wanted : 1u;
+		if (!fp6_cs_setup(t)) return 0;
+		for (unsigned iteration = 1; iteration <= runs; iteration++) {
+			if (!fp6_cs_submit(g, gpu, t, iteration)) {
+				printf("QCOM GPU COMPUTE: %s stopped at run %u of %u; %u of %u kernels passed\n",
+				    fp6_cs_tests[t].name, iteration, runs, passed, (unsigned)FP6_CS_TEST_COUNT);
+				return 0;
+			}
+		}
+		passed++;
+	}
+	printf("QCOM GPU COMPUTE: all %u kernels passed (kernel 0 repeated %d times)\n", passed, wanted);
+	return 1;
 }
 
