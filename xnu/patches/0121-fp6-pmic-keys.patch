--- /dev/null
+++ b/bsd/dev/fp6_keys.c
@@ -0,0 +1,232 @@
+/*
+ * FP6 side and volume keys, polled, read only.
+ *
+ * Power and volume down are the PMK8550 PON_HLOS block (SPMI bus 0, SID 0,
+ * peripheral 0x13): PON_RT_STS 0x1310 bit 7 KPDPWR, bit 6 RESIN (GEN3,
+ * drivers/input/misc/pm8941-pwrkey.c). Volume up is PM7550 ("pmxr2230")
+ * GPIO 6 (SID 1, peripheral 0x8d), active low: RT_STS 0x8d10 bit 0
+ * (pinctrl-spmi-gpio.c). Reads use the v7 PMIC arbiter's observer channel
+ * for this EE (spmi-pmic-arb.c): the only MMIO write is the read command
+ * to that channel. No PMIC register is ever written.
+ *
+ * Boot-arg fp6keys=0 disables it.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_FP6)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_key(int key, int down);
+void fp6_keys_init(void);
+
+/* stock Volcano DT spmi0_bus: core, cnfg, obsrvr */
+#define ARB_CORE_PA             0x0c400000u
+#define ARB_CORE_SIZE           0x3000u
+#define ARB_CNFG_PA             0x0c42d000u
+#define ARB_CNFG_SIZE           0x4000u
+#define ARB_OBS_PA              0x0c440000u
+#define ARB_OBS_SIZE            0x8000u         /* EE 0 only */
+#define ARB_VERSION             0x0000u
+#define ARB_FEATURES            0x0004u
+#define ARB_APID_MAP(n)         (0x2000u + 4u * (n))
+#define ARB_OWNER(n)            (4u * (n))
+#define OBS_CHAN(apid)          (0x20u * (apid))
+#define CHAN_CMD                0x00u
+#define CHAN_STATUS             0x08u
+#define CHAN_RDATA0             0x18u
+#define NO_APID                 0xffffu
+
+#define PPID_PON                0x013u          /* SID 0, 0x1300 */
+#define PPID_VOLUP              0x18du          /* SID 1, 0x8d00 */
+#define KEY_POWER               0
+#define KEY_VOLUP               1
+#define KEY_VOLDOWN             2
+
+static struct {
+	bool started;
+	vm_offset_t core, cnfg, obs;
+	uint16_t apid_pon, apid_volup;
+	unsigned napid;
+	bool volup_ok;
+	int state[3], pending[3];
+} fk;
+static int fk_sleep_chan;
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+fk_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&fk_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* The APID that maps a PPID; prefer the one this EE (0) owns, as Linux does. */
+static uint16_t
+find_apid(uint16_t ppid)
+{
+	uint16_t found = NO_APID;
+	for (unsigned n = 0; n < fk.napid; ++n) {
+		uint32_t map = rd(fk.core, ARB_APID_MAP(n));
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if (found == NO_APID || (rd(fk.cnfg, ARB_OWNER(n)) & 7u) == 0) {
+			found = (uint16_t)n;
+		}
+	}
+	return found;
+}
+
+/* One byte through the observer channel (EXT_READL, byte count 0 = 1 byte). */
+static int
+pmic_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	vm_offset_t ch = fk.obs + OBS_CHAN(apid);
+	wr(ch, CHAN_CMD, (1u << 27) | ((uint32_t)(addr & 0xffu) << 4));
+	for (unsigned i = 0; i < 1000u; ++i) {
+		uint32_t st = rd(ch, CHAN_STATUS);
+		if (st & 1u) {
+			if (st & 0xeu) {        /* failure, denied, dropped */
+				return EIO;
+			}
+			*out = (uint8_t)rd(ch, CHAN_RDATA0);
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+static void
+report(int key, int down)
+{
+	/* Two equal samples in a row (40 ms) before a change is reported. */
+	if (down == fk.state[key]) {
+		fk.pending[key] = -1;
+		return;
+	}
+	if (fk.pending[key] != down) {
+		fk.pending[key] = down;
+		return;
+	}
+	fk.state[key] = down;
+	fk.pending[key] = -1;
+	sweet_hid_key(key, down);
+}
+
+static void
+keys_thread(void *arg __unused, wait_result_t wr_result __unused)
+{
+	uint8_t v = 0;
+	unsigned errors = 0;
+
+	fk_sleep(20000);        /* after the GUI services have registered */
+	fk.core = ml_io_map(ARB_CORE_PA, ARB_CORE_SIZE);
+	fk.cnfg = ml_io_map(ARB_CNFG_PA, ARB_CNFG_SIZE);
+	fk.obs = ml_io_map(ARB_OBS_PA, ARB_OBS_SIZE);
+	if (!fk.core || !fk.cnfg || !fk.obs) {
+		printf("FP6 KEYS: MMIO mapping failed\n");
+		goto out;
+	}
+	uint32_t version = rd(fk.core, ARB_VERSION);
+	fk.napid = rd(fk.core, ARB_FEATURES) & 0x7ffu;
+	if (version < 0x70000000u || version >= 0x80000000u || fk.napid == 0 || fk.napid > 1024u) {
+		printf("FP6 KEYS: PMIC arbiter version %#x, %u APIDs: not v7, keys disabled\n",
+		    version, fk.napid);
+		goto out;
+	}
+	fk.apid_pon = find_apid(PPID_PON);
+	fk.apid_volup = find_apid(PPID_VOLUP);
+	printf("FP6 KEYS: arbiter %#x, %u APIDs, PON apid %#x, vol-up GPIO apid %#x\n",
+	    version, fk.napid, fk.apid_pon, fk.apid_volup);
+	if (fk.apid_pon == NO_APID || pmic_read(fk.apid_pon, 0x1305, &v)) {
+		printf("FP6 KEYS: PON not readable; keys disabled\n");
+		goto out;
+	}
+	uint8_t sts = 0;
+	(void)pmic_read(fk.apid_pon, 0x1310, &sts);
+	printf("FP6 KEYS: PON subtype %#x (GEN3 HLOS is 0x9) rt_sts %#x\n", v, sts);
+	if (v != 0x09u) {
+		printf("FP6 KEYS: unexpected PON subtype; keys disabled\n");
+		goto out;
+	}
+	if (fk.apid_volup != NO_APID) {
+		uint8_t sub = 0, mode = 0, pull = 0, en = 0, rt = 0;
+		(void)pmic_read(fk.apid_volup, 0x8d05, &sub);
+		(void)pmic_read(fk.apid_volup, 0x8d40, &mode);
+		(void)pmic_read(fk.apid_volup, 0x8d42, &pull);
+		(void)pmic_read(fk.apid_volup, 0x8d46, &en);
+		(void)pmic_read(fk.apid_volup, 0x8d10, &rt);
+		/* MODE_CTL bits 1:0 = 0: digital input; EN_CTL bit 7: enabled. */
+		fk.volup_ok = (en & 0x80u) && (mode & 3u) == 0;
+		printf("FP6 KEYS: vol-up gpio6 subtype %#x mode %#x pull %#x en %#x rt %#x -> %s\n",
+		    sub, mode, pull, en, rt, fk.volup_ok ? "input" : "not an enabled input, unused");
+	}
+	for (int k = 0; k < 3; ++k) {
+		fk.state[k] = 0;
+		fk.pending[k] = -1;
+	}
+	printf("FP6 KEYS: polling power, volume down%s\n", fk.volup_ok ? ", volume up" : "");
+	for (;;) {
+		if (pmic_read(fk.apid_pon, 0x1310, &sts) == 0) {
+			report(KEY_POWER, (sts >> 7) & 1);
+			report(KEY_VOLDOWN, (sts >> 6) & 1);
+		} else if ((errors++ % 500u) == 0) {
+			printf("FP6 KEYS: PON read failed\n");
+		}
+		if (fk.volup_ok && pmic_read(fk.apid_volup, 0x8d10, &v) == 0) {
+			report(KEY_VOLUP, !(v & 1u));
+		}
+		fk_sleep(20);
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+fp6_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (fk.started) {
+		return;
+	}
+	fk.started = true;
+	(void)PE_parse_boot_argn("fp6keys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("FP6 KEYS: disabled (fp6keys=0)\n");
+		return;
+	}
+	if (kernel_thread_start(keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("FP6 KEYS: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_FP6 */
