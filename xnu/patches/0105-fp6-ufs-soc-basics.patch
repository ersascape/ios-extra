+/*
+ * Configure only UFS stream 0x60. Reuse any firmware mapping unchanged;
+ * when no mapping exists, create Linux Qualcomm's pass-through context-bank
+ * form, without changing global SMMU control or any other stream.
+ */
+static int
+fp6_smmu_prepare(uint16_t stream, uint64_t dma, uint64_t bytes)
+{
+	uint32_t idr0 = smmu_rd(FP6_SMMU_IDR0);
+	uint32_t idr1 = smmu_rd(FP6_SMMU_IDR1);
+	uint32_t idr2 = smmu_rd(FP6_SMMU_IDR2);
+	unsigned groups = idr0 & 0xff, banks = idr1 & 0xff;
+	unsigned pages = 1u << (((idr1 >> 28) & 7) + 1);
+	unsigned matches = 0, free_slot = UINT32_MAX, free_bank = UINT32_MAX;
+	uint32_t matched_smr = 0, matched_s2cr = 0;
+	if (!(idr0 & (1u << 30)) || !(idr2 & (1u << 12)) || !groups ||
+	    banks < 2 || banks > 128 || pages > 128 ||
+	    (pages + banks) * 4096 > 0x100000 || !bytes || dma + bytes < dma) {
+		printf("QCOM UFS: unsupported FP6 SMMU geometry idr0=%x idr1=%x idr2=%x\n",
+		    idr0, idr1, idr2);
+		return ENXIO;
+	}
+	ufs_error_detail = (idr0 & 0xffu) << 24 | (idr1 & 0xffu) << 16 | (idr2 & 0xffffu);
+	for (unsigned shift = 0; shift <= 8; shift += 4) {
+		unsigned bits = fp6_smmu_address_bits((idr2 >> shift) & 0xf);
+		if (!bits || dma >= (1ull << bits) || bytes > (1ull << bits) - dma)
+			return EINVAL;
+	}
+	if (groups > 128) groups = 128;
+	if (ufs_rd(REG_UTRLDBR) != 0) return EBUSY;
+	for (unsigned i = 0; i < groups; i++) {
+		uint32_t smr = smmu_rd(FP6_SMMU_SMR(i));
+		if (!(smr & 0x80000000u)) {
+			if (free_slot == UINT32_MAX) free_slot = i;
+			continue;
+		}
+		uint32_t s2cr = smmu_rd(FP6_SMMU_S2CR(i));
+		uint32_t mask = (smr >> 16) & 0x7fffu;
+		if (((smr ^ stream) & 0xffffu & ~mask) == 0) {
+			matches++;
+			matched_smr = smr;
+			matched_s2cr = s2cr;
+		}
+	}
+	if (matches) {
+		if (matches > 1) return EBUSY;
+		/* Existing firmware mapping carried our UTRD/response DMA; preserve it. */
+		printf("QCOM UFS: preserving SMMU mapping SID 0x%x SMR=%x S2CR=%x\n",
+		    stream, matched_smr, matched_s2cr);
+		return 0;
+	}
+	if (free_slot == UINT32_MAX) return ENOSPC;
+	for (unsigned back = 0; back < 8 && back + 1 < banks; back++) {
+		unsigned bank = banks - 1 - back;
+		bool used = false;
+		for (unsigned i = 0; i < groups; i++) {
+			uint32_t smr = smmu_rd(FP6_SMMU_SMR(i));
+			uint32_t s2cr = smmu_rd(FP6_SMMU_S2CR(i));
+			if ((smr & 0x80000000u) && ((s2cr >> 16) & 3u) == 0 &&
+			    (s2cr & 0xffu) == bank) used = true;
+		}
+		if (!used && !(smmu_rd((pages + bank) * 4096) & 1u)) {
+			free_bank = bank;
+			break;
+		}
+	}
+	if (free_bank == UINT32_MAX) return ENOSPC;
+	/* QCOM bypass_quirk: TRANSLATE -> reserved S1_TRANS_S2_BYPASS bank. */
+	smmu_wr((pages + free_bank) * 4096, 0);
+	smmu_wr(FP6_SMMU_CBA2R(free_bank), 1);       /* VA64 for physical DMA */
+	smmu_wr(FP6_SMMU_CBAR(free_bank), 0x10000);  /* S1_TRANS_S2_BYPASS */
+	if (smmu_rd((pages + free_bank) * 4096) != 0 ||
+	    smmu_rd(FP6_SMMU_CBA2R(free_bank)) != 1 ||
+	    smmu_rd(FP6_SMMU_CBAR(free_bank)) != 0x10000) return EIO;
+	/* Install context before making its stream match visible. */
+	smmu_wr(FP6_SMMU_S2CR(free_slot), free_bank); /* TRANSLATE */
+	if (smmu_rd(FP6_SMMU_S2CR(free_slot)) != free_bank) return EIO;
+	smmu_wr(FP6_SMMU_SMR(free_slot), 0x80000000u | stream);
+	if (smmu_rd(FP6_SMMU_SMR(free_slot)) != (0x80000000u | stream) ||
+	    smmu_rd(FP6_SMMU_S2CR(free_slot)) != free_bank) return EIO;
+	printf("QCOM UFS: SMMU pass-through SID 0x%x slot %u bank %u DMA %llx+%llx\n",
+	    stream, free_slot, free_bank, (unsigned long long)dma, (unsigned long long)bytes);
+	return 0;
+}
