+#if defined(ARM64_BOARD_CONFIG_FP6)
+/* Read UFS bCurrentPowerMode (attribute IDN 0x02) without changing state. */
+static int
+ufs_query_power_mode(uint32_t *mode)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = 0x16;             /* QUERY REQUEST */
+	ucd->cmd[3] = 1;                /* task tag */
+	ucd->cmd[5] = 1;                /* standard read request */
+	ucd->cmd[12] = 3;               /* READ ATTRIBUTE */
+	ucd->cmd[13] = 2;               /* bCurrentPowerMode */
+	utrd->dw0 = 1u << 28;
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)(su.dma_pa + DMA_UCD);
+	utrd->ucdbau = (uint32_t)((su.dma_pa + DMA_UCD) >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	__builtin_arm_dsb(0xf);
+	if (fp6_ahit_begin()) return EIO;
+	ufs_error_stage = "UFS power-mode query";
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) return ETIMEDOUT;
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	else dma_sync(DMA_UCD, sizeof(*ucd));
+	fp6_ahit_end();
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x36 || ucd->resp[3] != 1 ||
+	    ucd->resp[6] != 0 || ucd->resp[12] != 3 || ucd->resp[13] != 2) {
+		ufs_error_detail = (ocs << 24) | ((uint32_t)ucd->resp[0] << 16) |
+		    ((uint32_t)ucd->resp[6] << 8) | ucd->resp[12];
+		printf("QCOM UFS: power-mode query failed ocs=%x type=%x tag=%x response=%x echo=%x/%x\n",
+		    ocs, ucd->resp[0], ucd->resp[3], ucd->resp[6], ucd->resp[12], ucd->resp[13]);
+		return EIO;
+	}
+	*mode = ((uint32_t)ucd->resp[20] << 24) | ((uint32_t)ucd->resp[21] << 16) |
+	    ((uint32_t)ucd->resp[22] << 8) | ucd->resp[23];
+	printf("QCOM UFS: current power mode 0x%x\n", *mode);
+	return 0;
+}
+
+static int
+ufs_wake_device_if_needed(void)
+{
+	uint32_t mode = 0;
+	int error = ufs_query_power_mode(&mode);
+	if (error) return error;
+	if ((mode & 0xff) == 0x11) return 0;
+	/* Match Linux ufshcd_set_dev_pwr_mode(ACTIVE) on device well-known LU. */
+	static const uint8_t start[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	ufs_error_stage = "UFS device wake";
+	printf("QCOM UFS: requesting active power mode from 0x%x\n", mode);
+	error = ufs_scsi_lun(0xd0, start, sizeof(start), 0, false);
+	if (error) return error;
+	delay(50000);
+	return 0;
+}
