+static int
+fp6_ahit_begin(void)
+{
+#if defined(ARM64_BOARD_CONFIG_FP6)
+	if (!fp6_ahit_active) {
+		fp6_ahit_saved = ufs_rd(REG_AHIT);
+		__builtin_arm_dsb(0xf);
+		ufs_wr(REG_AHIT, 0);
+		__builtin_arm_dsb(0xf);
+		if (ufs_rd(REG_AHIT) != 0) {
+			ufs_wr(REG_AHIT, fp6_ahit_saved);
+			__builtin_arm_dsb(0xf);
+			return EIO;
+		}
+		fp6_ahit_active = true;
+	}
+#endif
+	return 0;
+}
+
+static void
+fp6_ahit_end(void)
+{
+#if defined(ARM64_BOARD_CONFIG_FP6)
+	if (fp6_ahit_active) {
+		ufs_wr(REG_AHIT, fp6_ahit_saved);
+		__builtin_arm_dsb(0xf);
+		fp6_ahit_active = false;
+	}
+#endif
+}
