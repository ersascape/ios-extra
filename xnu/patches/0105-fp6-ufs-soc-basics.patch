+static unsigned
+fp6_smmu_address_bits(unsigned code)
+{
+	switch (code) {
+	case 0: return 32;
+	case 1: return 36;
+	case 2: return 40;
+	case 3: return 42;
+	case 4: return 44;
+	case 5: return 48;
+	default: return 0;
+	}
+}
