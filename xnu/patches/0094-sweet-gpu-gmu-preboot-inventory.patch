+/* Read only after the already measured buffer test has disabled its mapping. */
+static void
+gpu_gmu_preboot_read(vm_offset_t gmu, struct gpu_power_experiment *x)
+{
+	x->preboot_requested = 1;
+	if (!x->buf.requested || x->buf.error || x->buf.stage != 3 ||
+	    x->buf.passed != GPU_BUF_CHECKS || x->buf.checks != GPU_BUF_CHECKS || !x->buf.inactive) {
+		x->preboot_error = "buffer/ATOS/inactive gate not satisfied; pre-boot dump skipped";
+		return;
+	}
+	if (gpu_read32(gmu, 0x14000) != 1 || gpu_read32(gmu, 0x14068) != 0) {
+		x->preboot_error = "CM3 reset/idle precondition failed; pre-boot dump skipped";
+		return;
+	}
+	for (unsigned int i = 0; i < GPU_PREBOOT_READS; i++) {
+		printf("SWEET GPU: reading pre-boot GMU %s +0x%x\n", gpu_preboot_regs[i].name, gpu_preboot_regs[i].off);
+		x->preboot_value[i] = gpu_read32(gmu, gpu_preboot_regs[i].off);
+		x->preboot_done = i + 1;
+	}
+}
