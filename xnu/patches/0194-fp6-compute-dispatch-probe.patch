+/* Replays a Mesa-generated A810 compute dispatch (tools/fp6-gen-compute.py) through
+ * the firmware BR ring: eight invocations each read a word, add 5 and write it
+ * back. Mesa's shim IOVAs in the stream are replaced with real GPU addresses;
+ * the stream's final CP_EVENT_WRITE7 seqno is used as the completion fence. */
+static struct fp6_gpu_global_page fp6_cs_shader_page, fp6_cs_uav_page, fp6_cs_data_page;
+static uint64_t fp6_cs_shader_va, fp6_cs_uav_va, fp6_cs_data_va;
+static int fp6_cs_pages_ready;
+#define FP6_CS_FENCE_OFFSET 0x40u /* dwords 16..; result page word 0 is untouched */
+#define FP6_CS_RING_DWORDS (2u + 1u + 151u + 1u + 2u)
+
+static void
+fp6_cs_patch(uint32_t *stream, const uint16_t *reloc, unsigned count, uint64_t va)
+{
+	for (unsigned i = 0; i < count; i++) {
+		stream[reloc[2 * i]] = (uint32_t)va;
+		stream[reloc[2 * i + 1]] = (uint32_t)(va >> 32);
+	}
+}
+
+static int
+fp6_gpu_compute_probe(vm_offset_t g, vm_offset_t gpu)
+{
+	int wanted = 0;
+	if (!PE_parse_boot_argn("fp6gpucompute", &wanted, sizeof(wanted)) || wanted != 1) {
+		printf("QCOM GPU COMPUTE: skipped; fp6gpucompute=1 not requested\n");
+		return 1;
+	}
+	if (!fp6_exec_pages_ready) {
+		printf("QCOM GPU COMPUTE: refused; execution pages unavailable\n");
+		return 0;
+	}
+	if (!fp6_cs_pages_ready) {
+		if (!fp6_gpu_exec_alloc(4096u, 0u, &fp6_cs_shader_page, &fp6_cs_shader_va) ||
+		    !fp6_gpu_exec_alloc(4096u, 0u, &fp6_cs_uav_page, &fp6_cs_uav_va) ||
+		    !fp6_gpu_exec_alloc(4096u, FP6_GPU_GLOBAL_GFX_WRITE, &fp6_cs_data_page, &fp6_cs_data_va)) {
+			printf("QCOM GPU COMPUTE: buffer allocation failed; mappings retained\n");
+			return 0;
+		}
+		memset(fp6_cs_shader_page.va, 0, 4096u);
+		memcpy(fp6_cs_shader_page.va, fp6_cs_shader, sizeof(fp6_cs_shader));
+		memset(fp6_cs_uav_page.va, 0, 4096u);
+		uint32_t *desc = (uint32_t *)(void *)fp6_cs_uav_page.va;
+		memcpy(desc, fp6_cs_uav_template, sizeof(fp6_cs_uav_template));
+		desc[0] = (uint32_t)fp6_cs_data_va;
+		desc[1] = (desc[1] & ~0x1ffffu) | (uint32_t)((fp6_cs_data_va >> 32) & 0x1ffffu);
+		memset(fp6_cs_data_page.va, 0, 4096u);
+		memcpy(fp6_cs_data_page.va, fp6_cs_data_init, sizeof(fp6_cs_data_init));
+		(void)fp6_gpu_kernel_publish(NULL, fp6_cs_shader_page.va, 4096u);
+		(void)fp6_gpu_kernel_publish(NULL, fp6_cs_uav_page.va, 4096u);
+		(void)fp6_gpu_kernel_publish(NULL, fp6_cs_data_page.va, 4096u);
+		fp6_cs_pages_ready = 1;
+		printf("QCOM GPU COMPUTE: shader=0x%llx uav=0x%llx data=0x%llx fence=0x%llx\n",
+		    (unsigned long long)fp6_cs_shader_va, (unsigned long long)fp6_cs_uav_va,
+		    (unsigned long long)fp6_cs_data_va,
+		    (unsigned long long)(fp6_exec_result_va + 4u * FP6_CS_FENCE_OFFSET));
+	}
+	uint64_t base = ((uint64_t)fp6_smmu_read32(gpu, FP6_GPU_CP_RB_BASE_HI) << 32) |
+	    fp6_smmu_read32(gpu, FP6_GPU_CP_RB_BASE_LO);
+	uint32_t cntl = fp6_smmu_read32(gpu, FP6_GPU_CP_RB_CNTL);
+	uint32_t rptr = fp6_smmu_read32(gpu, FP6_GPU_CP_RB_RPTR_BR);
+	uint32_t wptr = fp6_smmu_read32(gpu, FP6_GPU_CP_RB_WPTR_GC);
+	struct fp6_hfi_mem_alloc *ring = NULL;
+	for (unsigned i = 0; i < fp6_hfi_mem_alloc_count; i++) {
+		if (fp6_hfi_mem_allocs[i].mem_kind == 1u && base &&
+		    fp6_hfi_mem_allocs[i].gpu_address == base) {
+			ring = &fp6_hfi_mem_allocs[i];
+			break;
+		}
+	}
+	uint64_t size = (uint64_t)2 << (cntl & 0xffu);
+	if (!ring || rptr != wptr || (uint64_t)wptr + FP6_CS_RING_DWORDS >= size ||
+	    size * 4u > ring->desc[7]) {
+		printf("QCOM GPU COMPUTE: ring unavailable (ring=%u size=%llu rptr=%u wptr=%u); no submit\n",
+		    ring != NULL, (unsigned long long)size, rptr, wptr);
+		return 0;
+	}
+	uint32_t cmd[FP6_CS_RING_DWORDS];
+	uint32_t stream[sizeof(fp6_cs_stream) / sizeof(fp6_cs_stream[0])];
+	memcpy(stream, fp6_cs_stream, sizeof(stream));
+	fp6_cs_patch(stream, fp6_cs_shader_reloc, FP6_CS_SHADER_RELOCS, fp6_cs_shader_va);
+	fp6_cs_patch(stream, fp6_cs_uav_reloc, FP6_CS_UAV_RELOCS, fp6_cs_uav_va);
+	fp6_cs_patch(stream, fp6_cs_control_reloc, FP6_CS_CONTROL_RELOCS,
+	    fp6_exec_result_va + 4u * FP6_CS_FENCE_OFFSET);
+	unsigned n = 0;
+	cmd[n++] = fp6_cp_type7_packet(0x17u, 1u); /* CP_THREAD_CONTROL: BR, sync */
+	cmd[n++] = 1u | (1u << 31);
+	cmd[n++] = fp6_cp_type7_packet(0x26u, 0u); /* CP_WAIT_FOR_IDLE */
+	memcpy(&cmd[n], stream, sizeof(stream));
+	n += (unsigned)(sizeof(stream) / sizeof(stream[0]));
+	cmd[n++] = fp6_cp_type7_packet(0x26u, 0u);
+	cmd[n++] = fp6_cp_type7_packet(0x17u, 1u); /* CP_THREAD_CONTROL: both */
+	cmd[n++] = 3u;
+	if (n != FP6_CS_RING_DWORDS) {
+		printf("QCOM GPU COMPUTE: internal command size mismatch %u\n", n);
+		return 0;
+	}
+	volatile uint32_t *fence = (volatile uint32_t *)(void *)(fp6_exec_result.va + 4u * FP6_CS_FENCE_OFFSET);
+	*fence = 0xdeadbeefu;
+	(void)fp6_gpu_kernel_publish(NULL, fp6_exec_result.va, 4096u);
+	volatile uint32_t *slot = (volatile uint32_t *)(void *)(ring->backing.va + 4u * wptr);
+	for (unsigned i = 0; i < n; i++) slot[i] = cmd[i];
+	(void)fp6_gpu_kernel_publish(NULL, ring->backing.va + 4u * wptr, 4u * n);
+	__asm__ volatile("dsb sy" ::: "memory");
+	unsigned dropped = 0;
+	for (unsigned attempt = 0; attempt < 2u; attempt++) {
+		fp6_smmu_write32(gpu, FP6_GPU_CP_RB_WPTR_GC, wptr + n);
+		dropped = fp6_smmu_read32(g, FP6_GMU_AHB_FENCE_STATUS) & 1u;
+		if (!dropped) break;
+	}
+	uint32_t seen = 0, now_rptr = 0;
+	for (unsigned i = 0; i < 5000u; i++) {
+		fp6_gpu_invalidate_cpu_cache(fp6_exec_result.va, 4096u);
+		seen = *fence;
+		now_rptr = fp6_smmu_read32(gpu, FP6_GPU_CP_RB_RPTR_BR);
+		if (seen == 1u && now_rptr == wptr + n) break;
+		delay(100);
+	}
+	fp6_gpu_invalidate_cpu_cache(fp6_cs_data_page.va, 4096u);
+	const volatile uint32_t *data = (const volatile uint32_t *)(const void *)fp6_cs_data_page.va;
+	unsigned good = 0;
+	for (unsigned i = 0; i < FP6_CS_ELEMENTS; i++)
+		good += data[i] == fp6_cs_data_init[i] + 5u;
+	printf("QCOM GPU COMPUTE: submit dwords=%u dropped=%u fence=0x%08x rptr=%u/%u data=%u,%u,%u,%u,%u,%u,%u,%u correct=%u/%u CB0_FSR=0x%08x\n",
+	    n, dropped, seen, now_rptr, wptr + n, data[0], data[1], data[2], data[3], data[4], data[5],
+	    data[6], data[7], good, FP6_CS_ELEMENTS,
+	    fp6_smmu_read32(fp6_gpu_smmu_base, fp6_gpu_cb_off + FP6_SMMU_CB_FSR));
+	fp6_gpu_exec_snapshot(g, gpu, "after-compute");
+	return good == FP6_CS_ELEMENTS;
+}
+
 static int
 fp6_gpu_exec_probe(vm_offset_t g, vm_offset_t gpu, uint8_t *hfi_mem,
 		unsigned *sequence)
@@ -4701,6 +4832,7 @@
 		return 0;
 	}
 	(void)fp6_gpu_ring_probe(g, gpu);
+	(void)fp6_gpu_compute_probe(g, gpu);
 	printf("QCOM GPU EXEC: diagnostic complete; full gen8_start register policy and draw/readback remain pending\n");
 	return 1;
 }
