+/* Read-only controller/GPT validation while another root device is used. */
+int
+sweet_ufs_probe(void)
+{
+	int error = sweet_ufs_init(false);
+	if (error) {
+		printf("QCOM UFS: read-only probe failed (%d)\n", error);
+		return error;
+	}
+	printf("QCOM UFS: read-only probe found userdata at block 0x%llx (%llu MiB)\n",
+	    su.first_block, su.nblocks * UFS_BLOCK >> 20);
+	return 0;
+}
