+#if defined(ARM64_BOARD_CONFIG_FP6)
+/* Passive reads only: Qualcomm Cliffs TLMM input state and SPI0 GENI state. */
+int
+fp6_gpio_probe(void)
+{
+	static const unsigned reserved[] = { 56, 57, 58, 59, 60 };
+	volatile uint32_t *tlmm;
+	uint64_t inputs[3] = { 0, 0, 0 };
+	unsigned pin, i, bank;
+
+	tlmm = (volatile uint32_t *)ml_io_map(0x0f000000, 0x01000000);
+	if (tlmm == NULL) {
+		printf("FP6 GPIO: unable to map Cliffs TLMM\n");
+		return ENXIO;
+	}
+	for (pin = 0; pin < 179; pin++) {
+		for (i = 0; i < sizeof(reserved) / sizeof(reserved[0]); i++) {
+			if (pin == reserved[i]) {
+				break;
+			}
+		}
+		if (i != sizeof(reserved) / sizeof(reserved[0])) {
+			continue;
+		}
+		bank = pin / 64;
+		if (tlmm[(0x100004 + 0x1000 * pin) / sizeof(uint32_t)] & 1) {
+			inputs[bank] |= 1ULL << (pin % 64);
+		}
+	}
+	printf("FP6 GPIO: Cliffs TLMM read-only input bitmap 0=%016llx 1=%016llx 2=%016llx (reserved 56-60 skipped)\n",
+	    inputs[0], inputs[1], inputs[2]);
+	return 0;
+}
+
+int
+fp6_touch_probe(void)
+{
+	DTEntry spi;
+	char const *status = NULL;
+	unsigned int size = 0;
+	int error;
+
+	/* Inspect the handed-off DT only; the base DT marks this block disabled. */
+	error = SecureDTLookupEntry(NULL,
+	    "/soc/qcom,qupv3_0_geni_se@ac0000/spi@a80000", &spi);
+	if (error != kSuccess) {
+		printf("FP6 TOUCH: ESWIN EPH86xx is on SPI0, but SPI0 is absent from the handed-off DT\n");
+		return ENOENT;
+	}
+	error = SecureDTGetProperty(spi, "status", (void const **)&status, &size);
+	if (error == kSuccess && size > 0) {
+		printf("FP6 TOUCH: ESWIN EPH86xx on QUPv3 SPI0 (0xa80000), DT status '%s'; no MMIO access attempted\n",
+		    status);
+	} else {
+		printf("FP6 TOUCH: ESWIN EPH86xx on QUPv3 SPI0 (0xa80000), DT status absent; no MMIO access attempted\n");
+	}
+	return 0;
+}
+#endif
